{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frost.invalid/schema/shell.schema.json",
  "title": "Frost shell configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bar", "osd", "surfaces"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "position"],
      "properties": {
        "enabled": { "type": "boolean" },
        "position": { "enum": ["top", "bottom"] }
      }
    },
    "osd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launcher", "commandCenter", "notificationCenter", "clipboard", "emojiPicker", "imagePicker", "appInstaller", "tailscale", "agents"],
      "properties": {
        "launcher": { "type": "boolean" },
        "commandCenter": { "type": "boolean" },
        "notificationCenter": { "type": "boolean" },
        "clipboard": { "type": "boolean" },
        "emojiPicker": { "type": "boolean" },
        "imagePicker": { "type": "boolean" },
        "appInstaller": { "type": "boolean" },
        "tailscale": { "type": "boolean" },
        "agents": { "type": "boolean" }
      }
    }
  }
}
