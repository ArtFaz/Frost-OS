{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frost.invalid/schema/shell.schema.json",
  "title": "Frost Island configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "island"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "island": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "handleStyle", "idleWidth", "idleHeight"],
      "properties": {
        "enabled": { "type": "boolean" },
        "handleStyle": { "enum": ["bump", "strip"] },
        "idleWidth": { "type": "integer", "minimum": 300, "maximum": 520, "multipleOf": 10 },
        "idleHeight": { "type": "integer", "minimum": 112, "maximum": 180, "multipleOf": 4 }
      }
    }
  }
}
