#!/bin/bash
# Frost first-boot reconciliation. Runs once, as root, before the display
# manager. Idempotent and defensive: every step is guarded so it degrades
# cleanly on a base that lacks the tool or the filesystem it expects. It never
# touches user data and never runs a user migration.

set -euo pipefail
export LC_ALL=C

marker=/var/lib/frost/firstboot-done
share=/usr/share/frost/default

log() { printf 'frost-firstboot: %s\n' "$1"; }

if [[ -f $marker ]]; then
  log 'already done'
  exit 0
fi

# 1. Harden the Hyprlock PAM stack over the hyprlock package's "include login"
#    default. Keep a copy of whatever was there.
if [[ -f $share/pam/hyprlock ]]; then
  if ! cmp -s "$share/pam/hyprlock" /etc/pam.d/hyprlock 2>/dev/null; then
    [[ -f /etc/pam.d/hyprlock ]] && cp -a /etc/pam.d/hyprlock /etc/pam.d/hyprlock.frost-saved
    install -Dm644 "$share/pam/hyprlock" /etc/pam.d/hyprlock
    log 'installed hardened /etc/pam.d/hyprlock'
  fi
fi

# 2. Snapper on a Btrfs root: create the config once, point conf.d at it, and
#    enable the timers. Skipped entirely if root is not Btrfs or snapper is
#    absent.
if command -v snapper >/dev/null && [[ $(findmnt -n -o FSTYPE / 2>/dev/null || true) == btrfs ]]; then
  if [[ ! -f /etc/snapper/configs/root ]]; then
    snapper -c root create-config / && log 'created snapper config: root'
  fi
  if [[ -f /etc/conf.d/snapper ]] && ! grep -q '^SNAPPER_CONFIGS=.*\broot\b' /etc/conf.d/snapper; then
    if grep -q '^SNAPPER_CONFIGS=' /etc/conf.d/snapper; then
      sed -i 's/^SNAPPER_CONFIGS="\(.*\)"/SNAPPER_CONFIGS="\1 root"/; s/"  */"/; s/ *"/"/' /etc/conf.d/snapper
    else
      printf 'SNAPPER_CONFIGS="root"\n' >> /etc/conf.d/snapper
    fi
    log 'registered snapper config in /etc/conf.d/snapper'
  fi
  for timer in snapper-timeline.timer snapper-cleanup.timer; do
    systemctl list-unit-files "$timer" >/dev/null 2>&1 \
      && systemctl enable --now "$timer" >/dev/null 2>&1 \
      && log "enabled $timer"
  done
else
  log 'snapper step skipped (no btrfs root or no snapper)'
fi

# 3. Firewall: default-deny inbound, enable at boot. Skipped if ufw is absent.
#    If sshd is enabled on this base, punch a hole for it first so enabling the
#    firewall never drops a remote session.
if command -v ufw >/dev/null; then
  ufw --force default deny incoming >/dev/null
  ufw --force default allow outgoing >/dev/null
  if systemctl is-enabled sshd.service >/dev/null 2>&1 \
     || systemctl is-active sshd.service >/dev/null 2>&1; then
    ufw allow OpenSSH >/dev/null 2>&1 \
      || ufw allow ssh >/dev/null 2>&1 \
      || ufw allow 22/tcp >/dev/null 2>&1 || true
    log 'allowed SSH (sshd is enabled)'
  fi
  ufw --force enable >/dev/null
  systemctl enable ufw >/dev/null 2>&1 || true
  log 'ufw enabled, default deny incoming'
fi

# 4. mDNS: nss-mdns is installed but does nothing until nsswitch.conf asks for
#    it. Insert mdns_minimal ahead of the regular resolver in the hosts line so
#    .local names resolve. Surgical and idempotent; a copy is kept.
nss=/etc/nsswitch.conf
if [[ -f $nss ]] && command -v avahi-daemon >/dev/null && ! grep -q '^hosts:.*mdns' "$nss"; then
  cp -a "$nss" "$nss.frost-saved"
  sed -i -E 's/^(hosts:[[:space:]]+)(.*)$/\1mdns_minimal [NOTFOUND=return] \2/' "$nss"
  log 'added mdns_minimal to /etc/nsswitch.conf'
fi

# 5. Login keyring: pam_gnome_keyring in the SDDM stack unlocks the login
#    keyring with the login password, so libsecret apps do not prompt. Optional
#    modules with a leading '-', so a missing module is never fatal. A copy is
#    kept.
pam_sddm=/etc/pam.d/sddm
if [[ -f $pam_sddm ]] && [[ -e /usr/lib/security/pam_gnome_keyring.so ]] \
   && ! grep -q 'pam_gnome_keyring' "$pam_sddm"; then
  cp -a "$pam_sddm" "$pam_sddm.frost-saved"
  sed -i -E '0,/^auth[[:space:]]/s//-auth       optional   pam_gnome_keyring.so\n&/' "$pam_sddm"
  sed -i -E '0,/^session[[:space:]]/s//-session   optional   pam_gnome_keyring.so auto_start\n&/' "$pam_sddm"
  log 'wired pam_gnome_keyring into /etc/pam.d/sddm'
fi

# 6. Mirrors: reflector owns /etc/xdg/reflector/reflector.conf, so it is
#    reconciled here rather than shipped. reflector.timer is enabled by the
#    bootstrap; this only gives it Frost's filters. A copy is kept.
reflector_conf=/etc/xdg/reflector/reflector.conf
if [[ -f $share/reflector/reflector.conf && -d /etc/xdg/reflector ]] \
   && ! cmp -s "$share/reflector/reflector.conf" "$reflector_conf" 2>/dev/null; then
  [[ -f $reflector_conf ]] && cp -a "$reflector_conf" "$reflector_conf.frost-saved"
  install -Dm644 "$share/reflector/reflector.conf" "$reflector_conf"
  log 'installed Frost reflector.conf'
fi

# 7. zram tuning is delivered as package files; nothing to reconcile.

install -d -m0755 "$(dirname -- "$marker")"
: > "$marker"
log 'complete'
