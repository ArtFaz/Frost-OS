#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
repo=${FROST_REPO_DIR:-$root/repo/x86_64}
keyring="$root/pkgbuilds/frost-keyring/frost.gpg"

if [[ ! -d $repo ]]; then
  printf '%s\n' 'signatures: skipped (no local repository)'
  exit 0
fi

mapfile -t packages < <(find "$repo" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print | sort)
if ((${#packages[@]} < 2)); then
  printf '%s\n' 'signed repository must contain frost and frost-keyring' >&2
  exit 1
fi

for package in "${packages[@]}"; do
  [[ -f $package.sig ]] || {
    printf 'missing signature: %s.sig\n' "$package" >&2
    exit 1
  }
  gpgv --keyring "$keyring" "$package.sig" "$package" >/dev/null
done

for database in frost.db.tar.gz frost.files.tar.gz; do
  [[ -f $repo/$database && -f $repo/$database.sig ]] || {
    printf 'missing signed database: %s\n' "$database" >&2
    exit 1
  }
  gpgv --keyring "$keyring" "$repo/$database.sig" "$repo/$database" >/dev/null
done

# The repository holds only Frost-owned packages: frost and frost-keyring
# always, plus any of frost-meta / frost-settings / frost-wallpapers that have
# been built.
mapfile -t names < <(bsdtar -xOf "$repo/frost.db.tar.gz" '*/desc' | sed -n '/^%NAME%$/{n;p;}' | sort)
known=' frost frost-keyring frost-meta frost-settings frost-wallpapers '
for name in "${names[@]}"; do
  [[ $known == *" $name "* ]] || { printf 'unexpected repository package: %s\n' "$name" >&2; exit 1; }
done
for required in frost frost-keyring; do
  printf '%s\n' "${names[@]}" | grep -qx "$required" || { printf 'repository is missing %s\n' "$required" >&2; exit 1; }
done

printf '%s\n' 'signatures: ok'
