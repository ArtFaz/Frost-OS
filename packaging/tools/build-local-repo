#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source_repo=${FROST_SOURCE:-$root/..}
destination=$root/repo/x86_64

# The repository is built on the machine that consumes it, reached through a
# file:// URL by the only user of this system. Nothing is in transit, so nothing
# is signed; see docs/security-boundaries.md for the condition that reverses that.
usage() {
  printf '%s\n' 'usage: build-local-repo [--source PATH] [--destination PATH]' >&2
  exit 2
}

while (($# > 0)); do
  case $1 in
    --source)
      (($# >= 2)) || usage
      source_repo=$2
      shift 2
      ;;
    --destination)
      (($# >= 2)) || usage
      destination=$2
      shift 2
      ;;
    *) usage ;;
  esac
done

"$root/tools/validate-package-config"
mkdir -p "$destination"

# Everything is built into a fresh staging directory so the database is rebuilt
# from exactly this run's packages. $destination keeps every past build as an
# archive, but only the current versions go into frost.db.
staging=$(mktemp -d /tmp/frost-repo-staging.XXXXXX)
case $staging in /tmp/frost-repo-staging.*) ;; *) exit 1 ;; esac
trap 'rm -rf -- "$staging"' EXIT

FROST_SOURCE="$source_repo" PKGDEST="$staging" "$root/tools/build-frost-package" >/dev/null
for extra_pkg in frost-wallpapers frost-settings; do
  if [[ -f $root/pkgbuilds/$extra_pkg/PKGBUILD ]]; then
    FROST_SOURCE="$source_repo" PKGDEST="$staging" "$root/tools/build-frost-package" "$extra_pkg" >/dev/null
  fi
done

# frost-meta / frost-settings gates are handled by validate-package-config.
# frost-meta is pure metadata, so --nodeps: its depends() name packages this
# repo does not carry.
if [[ -f $root/pkgbuilds/frost-meta/PKGBUILD ]]; then
  meta_build=$(mktemp -d /tmp/frost-meta-package.XXXXXX)
  case $meta_build in /tmp/frost-meta-package.*) ;; *) exit 1 ;; esac
  trap 'rm -rf -- "$staging" "$meta_build"' EXIT
  cp -a "$root/pkgbuilds/frost-meta/." "$meta_build/"
  (
    cd "$meta_build"
    PKGDEST="$staging" makepkg --cleanbuild --force --noconfirm --nodeps
  )
fi

mapfile -t staged < <(find "$staging" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print | sort)
if ((${#staged[@]} == 0)); then
  printf '%s\n' 'No packages were built.' >&2
  exit 1
fi

cp -f "$staging"/*.pkg.tar.* "$destination/"
packages=()
for package in "${staged[@]}"; do
  packages+=( "$destination/$(basename -- "$package")" )
done

# Rebuild the database from this run's packages only.
rm -f "$destination"/frost.db* "$destination"/frost.files*
repo-add "$destination/frost.db.tar.gz" "${packages[@]}"

printf 'Frost repository: file://%s\n' "$(realpath "$destination")"

