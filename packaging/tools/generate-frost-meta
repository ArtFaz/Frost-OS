#!/bin/bash
# Generate pkgbuilds/frost-meta/PKGBUILD from the approved frost-packages.json.
# frost-meta is pure metadata: its depends() is the Arch/Frost half of the
# resolved package set, minus BOOTSTRAP (the CachyOS base owns that) and minus
# AUR (those stay in aur.lock.json, installed later with paru). The PKGBUILD is
# committed and reviewed; this only keeps it in sync with the manifest.

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
manifest=$root/..-packages.json
inventory=$root/tools/package-selector/inventory.json
frost_bin=${FROST_BIN:-}

while (($#)); do
  case $1 in
    --manifest) manifest=${2:?}; shift 2 ;;
    --inventory) inventory=${2:?}; shift 2 ;;
    --frost-bin) frost_bin=${2:?}; shift 2 ;;
    -h | --help) sed -n '2,7p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

if [[ -z $frost_bin ]]; then
  for candidate in \
    "$(command -v frost || true)" \
    "$root/../cli/target/release/frost" \
    "$root/../cli/target/debug/frost"; do
    [[ -n $candidate && -x $candidate ]] && { frost_bin=$candidate; break; }
  done
fi
[[ -n $frost_bin && -x $frost_bin ]] || { printf 'frost binary not found; pass --frost-bin\n' >&2; exit 1; }
[[ -f $manifest ]] || { printf 'manifest not found: %s\n' "$manifest" >&2; exit 1; }
[[ -f $inventory ]] || { printf 'inventory not found: %s\n' "$inventory" >&2; exit 1; }

"$frost_bin" packages validate --inventory "$inventory" "$manifest" \
  || { printf 'manifest does not validate; refusing to generate\n' >&2; exit 1; }

inventory_version=$(jq -r '.inventoryVersion' "$manifest")
pkgver=${inventory_version//-/.}
manifest_sha=$(sha256sum "$manifest" | cut -d' ' -f1)

# resolved names -> category + source
resolved=$("$frost_bin" packages plan --inventory "$inventory" "$manifest" --json 2>/dev/null \
  | jq -r '.resolved[]' | LC_ALL=C sort)
inv_cs=$(jq -r '.packages[] | [.name, .category, .source] | @tsv' "$inventory" | LC_ALL=C sort)

mapfile -t depends < <(
  LC_ALL=C join -t$'\t' <(printf '%s\n' "$resolved") <(printf '%s\n' "$inv_cs") \
    | awk -F'\t' '$3 != "aur" && $2 != "BOOTSTRAP" && $1 != "frost-keyring" { print $1 }' \
    | LC_ALL=C sort -u
)
((${#depends[@]} > 0)) || { printf 'no dependencies resolved\n' >&2; exit 1; }

out=$root/pkgbuilds/frost-meta/PKGBUILD
{
  printf '# Generated by tools/generate-frost-meta from frost-packages.json.\n'
  printf '# inventoryVersion %s, manifest sha256 %s\n' "$inventory_version" "$manifest_sha"
  printf '# Re-run the generator after the manifest changes; do not hand-edit the list.\n\n'
  printf "pkgname=frost-meta\n"
  printf "pkgver=%s\n" "$pkgver"
  printf "pkgrel=1\n"
  printf "pkgdesc='The Frost default package set, resolved from the approved frost-packages.json'\n"
  printf "arch=('any')\n"
  printf "url='https://github.com/ArtFaz/Frost-OS'\n"
  printf "license=('MIT')\n"
  printf "options=('!debug')\n"
  printf 'depends=(\n'
  printf "  '%s'\n" "${depends[@]}"
  printf ')\n\n'
  cat <<'PKGBUILD_BODY'
package() {
  install -d "$pkgdir/usr/share/doc/frost-meta"
  {
    printf 'frost-meta %s-%s\n' "$pkgver" "$pkgrel"
    printf 'Resolved from the approved frost-packages.json at Gate 5.\n'
    printf 'AUR selections are not dependencies here; see aur.lock.json.\n\n'
    printf 'depends:\n'
    printf '  %s\n' "${depends[@]}"
  } > "$pkgdir/usr/share/doc/frost-meta/manifest.txt"
}
PKGBUILD_BODY
} > "$out"

printf 'wrote %s\n' "$out"
printf '  pkgver %s, %s dependencies\n' "$pkgver" "${#depends[@]}"
