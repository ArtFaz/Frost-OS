#!/bin/bash
# Reconciliation aid for inventory.json. Read-only: it reads frozen donor package
# lists, the frost package's own dependencies and (when available) the local
# pacman database, then prints one draft record per candidate for a human to
# classify. It never calls pacman -S/-R, never writes the inventory, and never
# touches the system. Its output is a starting point, not an authority.
#
# Usage:
#   tools/package-selector/build-inventory [--donor-root DIR] > draft.json
#
# The final inventory.json is hand-curated and version-controlled. This script
# only tells you which sources mention a name and offers a category guess.

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
donor_root="$root/../Definitive Frost-OS"

while (($#)); do
  case $1 in
    --donor-root) donor_root=${2:?}; shift 2 ;;
    -h | --help) sed -n '2,15p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

base_list="$donor_root/omarchy/install/omarchy-base.packages"
other_list="$donor_root/omarchy/install/omarchy-other.packages"
iso_list="$donor_root/omarchy-iso/builder/archinstall.packages"
frost_pkgbuild="$root/pkgbuilds/frost/PKGBUILD"

names_from() {
  # package names only: strip comments and blank lines
  [[ -f $1 ]] || return 0
  sed -e 's/#.*//' -e 's/[[:space:]]//g' -- "$1" | grep -E '^[a-z0-9][a-z0-9@._+-]*$' || true
}

frost_depends() {
  [[ -f $frost_pkgbuild ]] || return 0
  awk '
    /^depends=\(/ { inside = 1; next }
    inside && /^\)/ { inside = 0 }
    inside {
      gsub(/['"'"'"()]/, "")
      gsub(/[<>=].*/, "")
      gsub(/[[:space:]]/, "")
      if ($0 ~ /^[a-z0-9]/) print $0
    }
  ' "$frost_pkgbuild"
}

is_hardware() {
  [[ $1 =~ (^|[-_])(linux|linux-headers|linux-firmware|kernel|dkms|nvidia|vulkan|mesa|ucode|firmware|broadcom|macbook|apple|t2|dell|asus|tuxedo|intel-media|intel-ipu|intel-lpmd|libva|thermald|sof-firmware|asdcontrol|ddcutil|bolt|macbook12) ]]
}

declare -A seen in_base in_other in_iso in_frost
add() { seen[$1]=1; }

while read -r n; do [[ -n $n ]] && { in_base[$n]=1; add "$n"; }; done < <(names_from "$base_list")
while read -r n; do [[ -n $n ]] && { in_other[$n]=1; add "$n"; }; done < <(names_from "$other_list")
while read -r n; do [[ -n $n ]] && { in_iso[$n]=1; add "$n"; }; done < <(names_from "$iso_list")
while read -r n; do [[ -n $n ]] && { in_frost[$n]=1; add "$n"; }; done < <(frost_depends)

have_pacman=0
command -v pacman >/dev/null 2>&1 && have_pacman=1

emit_record() {
  local name=$1 sources=$2 guess=$3 installed=$4 size=$5 repo=$6
  jq -cn \
    --arg name "$name" \
    --argjson sources "$sources" \
    --arg guess "$guess" \
    --argjson installed "$installed" \
    --argjson size "${size:-null}" \
    --arg repo "$repo" \
    '{name:$name, sources:$sources, guessCategory:$guess, installed:$installed, sizeKib:$size, repo:(if $repo == "" then null else $repo end)}'
}

records=()
for name in $(printf '%s\n' "${!seen[@]}" | sort); do
  src=()
  [[ -n ${in_iso[$name]:-} ]] && src+=('"archinstall"')
  [[ -n ${in_frost[$name]:-} ]] && src+=('"frost-depends"')
  [[ -n ${in_base[$name]:-} ]] && src+=('"omarchy-base"')
  [[ -n ${in_other[$name]:-} ]] && src+=('"omarchy-other"')
  sources_json="[$(IFS=,; echo "${src[*]}")]"

  if [[ -n ${in_iso[$name]:-} ]]; then
    guess=BOOTSTRAP
  elif [[ -n ${in_frost[$name]:-} ]]; then
    guess=CORE
  elif is_hardware "$name"; then
    guess=HARDWARE
  else
    guess=DESKTOP
  fi

  installed=false size=null repo=""
  if ((have_pacman)) && pacman -Qq -- "$name" >/dev/null 2>&1; then
    installed=true
    size=$(pacman -Qi -- "$name" 2>/dev/null | awk -F': *' '/^Installed Size/ {
      v=$2; sub(/ .*/, "", v); u=$2; sub(/^[0-9.]+ /, "", u)
      if (u ~ /MiB/) printf "%d", v*1024; else if (u ~ /GiB/) printf "%d", v*1024*1024; else printf "%d", v
    }')
    repo=$(pacman -Qi -- "$name" 2>/dev/null | awk -F': *' '/^Repository/ {print $2; exit}')
    [[ -z $size ]] && size=null
  fi

  records+=("$(emit_record "$name" "$sources_json" "$guess" "$installed" "$size" "$repo")")
done

printf '%s\n' "${records[@]}" | jq -s \
  --arg generatedAt "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --arg donorRoot "$donor_root" \
  '{
    generatedAt: $generatedAt,
    note: "Draft aid for hand-curating inventory.json. Not an authority. guessCategory and every reason must be reviewed by a human.",
    sources: {
      archinstall: ($donorRoot + "/omarchy-iso/builder/archinstall.packages"),
      omarchyBase: ($donorRoot + "/omarchy/install/omarchy-base.packages"),
      omarchyOther: ($donorRoot + "/omarchy/install/omarchy-other.packages"),
      frostDepends: "pkgbuilds/frost/PKGBUILD"
    },
    candidateCount: length,
    candidates: .
  }'
