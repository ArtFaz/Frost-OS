#!/bin/bash
# Turn a freshly installed CachyOS Minimal into a Frost system. Run with sudo
# from inside the extracted frost-install-bundle directory:
#
#   sudo ./bootstrap-cachyos
#
# The Frost packages come from a signed repository carried in the bundle; the
# rest of the set comes from the CachyOS repositories, so a network is required.
#
# The screen shows stages and results; the full output of every command lands in
# /var/log/frost-bootstrap.log, and the tail of it is printed when something
# fails. Every stage is idempotent: re-running this on a half-finished machine is
# the way to repair it.
#
# The repository it adds is built on this machine and read through a file://
# URL, so its packages are not signed — nothing is in transit to protect. See
# docs/security-boundaries.md.
#
# What it changes: pacman configuration, the base providers Frost
# replaces (FROST_REPLACES), the package set, the SDDM and frost-firstboot units,
# the invoking user's login shell and shell rc, and — only while the AUR apps
# build — one sudoers drop-in. The initramfs, the boot splash and the bootloader
# are left exactly as CachyOS configured them.

set -euo pipefail
export LC_ALL=C

readonly REPO_DEST=/var/lib/frost/repo
readonly LOG_FILE=/var/log/frost-bootstrap.log
readonly SUDOERS_DROPIN=/etc/sudoers.d/zz-frost-bootstrap
readonly BASHRC_LINE='. /usr/share/frost/default/bash/bashrc'
readonly MIN_FREE_KIB=$((15 * 1024 * 1024))
readonly PACKAGES=(frost frost-settings frost-meta)

# The providers Frost chooses, installed as their own transaction before
# anything that depends on them. Without this, pacman resolves each virtual
# dependency on its own and --noconfirm accepts the first candidate: `jack`
# would come from jack2 (unresolvable against the pipewire-jack that frost-meta
# requires), `vulkan-driver` from an NVIDIA stack, `ttf-font` from
# gnu-free-fonts and `tessdata` from the Afrikaans model. Every name here is a
# deliberate choice; the comment names the virtual it settles.
readonly FROST_PROVIDERS=(
  pipewire pipewire-alsa pipewire-jack pipewire-pulse # jack
  wireplumber                                         # pipewire-session-manager
  mesa lib32-mesa                                     # opengl-driver, lib32-opengl-driver
  vulkan-radeon lib32-vulkan-radeon                   # vulkan-driver
  ttf-dejavu                                          # ttf-font
  tesseract-data-eng                                  # tessdata
  openbsd-netcat                                      # netcat
  sudo                                                # takes over from sudo-rs
)

# CachyOS Minimal ships alternative providers that Conflict/Replace packages the
# Frost set pulls in. Each name here is removed when installed under that exact
# name, so the Frost provider can take over; this swap is the only removal the
# script performs. `sudo-rs` is deliberately absent: pacman swaps it for `sudo`
# within a transaction, so the machine is never left without /usr/bin/sudo.
readonly FROST_REPLACES=(
  jack2 jack pipewire-jack-client                 # -> pipewire-jack
  pulseaudio pulseaudio-alsa pulseaudio-bluetooth # -> pipewire-pulse / pipewire-alsa
  pulseaudio-jack pulseaudio-equalizer-ladspa
  pulseaudio-rtp pulseaudio-zeroconf pulseaudio-lirc
  pipewire-media-session                          # -> wireplumber
  virtualbox-guest-utils-nox                      # -> virtualbox-guest-utils
)

# Names that must not appear in the resolved plan: a provider Frost rejected, or
# a second kernel dragged in by one. Checked before the install runs, so a bad
# resolution costs a message instead of a half-installed system.
readonly FROST_UNWANTED='^(jack2|pulseaudio|pipewire-media-session|nvidia(-[0-9a-z]+)?-utils|linux(-lts|-zen|-hardened)?)$'

# CachyOS Minimal ships utility apps that clutter the Frost launcher. Their
# launcher entries are hidden per user with a NoDisplay override written into
# ~/.local/share/applications, which shadows /usr/share/applications. Only an id
# that resolves to an installed entry is written, so a wrong or absent name is a
# no-op; the user deletes the override file to bring an app back.
readonly FROST_HIDE_DESKTOP=(
  Alacritty.desktop
  avahi-discover.desktop bssh.desktop bvnc.desktop
  btop.desktop
  btrfs-assistant.desktop
  cachyos-hello.desktop
  cachyos-kernel-manager.desktop
  cachyos-packageinstaller.desktop
  lstopo.desktop
  limine-snapper-restore.desktop
  org.gnome.Meld.desktop
  micro.desktop
  qv4l2.desktop qvidcap.desktop
  scx-manager.desktop
  shelly.desktop
  uuctl.desktop
  pavucontrol.desktop pavucontrol-qt.desktop
)

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
invoker=${SUDO_USER:-}
aur_failed=()
aur_installed=0

[[ $EUID -eq 0 ]] || { printf 'bootstrap-cachyos: run as root (sudo ./bootstrap-cachyos)\n' >&2; exit 1; }

# fd 3 is the log. Everything the script says goes to both; everything a command
# says goes to the log alone and surfaces only when it fails.
exec 3>>"$LOG_FILE"

say() { printf '%s\n' "$1"; printf '%s\n' "$1" >&3; }
step() { say ''; say "== $1"; }
note() { say "   $1"; }
die() { printf 'bootstrap-cachyos: %s\n' "$1" >&2; printf 'bootstrap-cachyos: %s\n' "$1" >&3; exit 1; }

# Report a three-state helper: 0 did the work, 10 it was already in place,
# anything else failed. No success line may come from a path that did nothing.
report() {
  case $1 in
    0) note "$2" ;;
    10) note "$3" ;;
    *) note "$4" ;;
  esac
}

# A command whose output belongs in the log. On failure the tail is printed, so
# a quiet screen never hides the reason.
run() {
  local status=0
  "$@" >&3 2>&3 || status=$?
  ((status == 0)) && return 0
  printf '\n-- last lines of %s --\n' "$LOG_FILE" >&2
  tail -n 20 "$LOG_FILE" | sed 's/^/   /' >&2
  return "$status"
}

# Best effort: logged, never printed, failure is the caller's to interpret.
try_run() {
  local status=0
  "$@" >&3 2>&3 || status=$?
  return "$status"
}

printf '\n=== bootstrap-cachyos %s\n' "$(date -Is)" >&3

step 'preflight'
command -v pacman >/dev/null || die 'pacman not found — this is not an Arch/CachyOS base'
command -v pacman-conf >/dev/null || die 'pacman-conf not found'
[[ $(uname -m) == x86_64 ]] || die "the Frost repository is x86_64 only (this is $(uname -m))"
[[ -d $here/repo/x86_64 ]] || die 'repo/x86_64 is not next to this script'

# lib32-mesa is part of the set, so multilib is not optional.
pacman-conf --repo-list | grep -qx multilib \
  || die 'the [multilib] repository is disabled — enable it in /etc/pacman.conf, then re-run'

free_kib=$(df -kP / | awk 'NR == 2 { print $4 }')
((free_kib >= MIN_FREE_KIB)) \
  || die "not enough free space on / ($((free_kib / 1024 / 1024)) GiB, need $((MIN_FREE_KIB / 1024 / 1024)) GiB)"

# The invoking user decides three later stages, so it is settled once here.
has_invoker=0
if [[ -n $invoker && $invoker != root ]] && id -u "$invoker" >/dev/null 2>&1; then
  has_invoker=1
else
  note 'no unprivileged invoking user (use sudo, not a root shell)'
fi

if [[ $(findmnt -n -o FSTYPE / 2>/dev/null || true) != btrfs ]]; then
  note 'root is not Btrfs; snapshots and rollback will be unavailable'
fi
note "$(df -h / | awk 'NR == 2 { print $4 }') free on /, logging to $LOG_FILE"

step "installing the Frost repository under $REPO_DEST"
install -d -m0755 "$REPO_DEST"
# Replace rather than copy into: cp -a of a directory onto an existing one of
# the same name nests it, and a second run would build up repo/x86_64/x86_64.
rm -rf -- "${REPO_DEST:?}/x86_64"
install -d -m0755 "$REPO_DEST/x86_64"
cp -a "$here/repo/x86_64/." "$REPO_DEST/x86_64/"
if grep -q '^\[frost\]' /etc/pacman.conf; then
  note 'the [frost] repository was already configured'
else
  cat >> /etc/pacman.conf <<EOF

[frost]
SigLevel = Never
Server = file://$REPO_DEST/\$arch
EOF
  note 'added the [frost] repository to /etc/pacman.conf'
fi

step 'updating the base system'
# A full upgrade, not just a refresh: installing new packages against a stale
# base is a partial upgrade, which Arch and CachyOS do not support. Keyrings go
# first so the upgrade can verify what it downloads on an older image.
run pacman -Sy --noconfirm || die 'could not refresh the package databases — check the network and the mirrorlist'
keyrings=()
for keyring in archlinux-keyring cachyos-keyring; do
  pacman -Si "$keyring" >/dev/null 2>&1 && keyrings+=("$keyring")
done
if ((${#keyrings[@]})); then
  run pacman -S --needed --noconfirm "${keyrings[@]}" || die 'the keyring update failed'
fi
run pacman -Syu --noconfirm || die 'the base system upgrade failed; resolve it and re-run'
note 'base system up to date'

step 'swapping the base providers Frost replaces'
# Only names from the fixed FROST_REPLACES list, and only when a package is
# installed under that exact name — `pacman -Q <name>` also matches a *provider*
# (jack2 provides jack), which -Rdd cannot then remove.
mapfile -t installed_pkgs < <(pacman -Qq)
declare -A is_installed=()
for pkg in "${installed_pkgs[@]}"; do is_installed[$pkg]=1; done
present=()
for pkg in "${FROST_REPLACES[@]}"; do
  [[ -n ${is_installed[$pkg]:-} ]] && present+=("$pkg")
done
if ((${#present[@]})); then
  note "removing: ${present[*]}"
  run pacman -Rdd --noconfirm "${present[@]}" || die 'the provider swap failed'
else
  note 'nothing to replace'
fi

step 'installing the providers Frost chooses'
# --ask=4 auto-answers "yes" to a conflict with an installed package
# (--noconfirm alone answers "no" and aborts).
run pacman -S --needed --noconfirm --ask=4 "${FROST_PROVIDERS[@]}" \
  || die 'the provider transaction failed; the lines above name the conflict'
note "${#FROST_PROVIDERS[@]} providers pinned"

step 'checking the resolved plan'
targets=(base-devel git "${PACKAGES[@]}")
plan=$(pacman -S --needed --print --print-format '%n %s' "${targets[@]}") \
  || die 'the Frost package set does not resolve; the log names the conflict'
unwanted=$(awk '{print $1}' <<<"$plan" | grep -xE "$FROST_UNWANTED" || true)
[[ -z $unwanted ]] \
  || die "the resolved plan pulls in packages Frost replaces: $(tr '\n' ' ' <<<"$unwanted")"
note "$(grep -c . <<<"$plan") packages, $(awk '{s += $2} END {printf "%.0f", s / 1048576}' <<<"$plan") MiB to download"

step 'installing Frost'
note 'this is the long one; watch the log for progress'
run pacman -S --needed --noconfirm --ask=4 "${targets[@]}" || die 'the Frost install failed'
note "installed $(pacman -Q "${PACKAGES[@]}" | tr '\n' ' ')"

step 'enabling the display manager and first-boot reconciliation'
run systemctl enable --force sddm.service || die 'could not enable sddm'
run systemctl enable frost-firstboot.service || die 'could not enable frost-firstboot'
note 'sddm and frost-firstboot enabled'

if [[ -x /usr/lib/frost/frost-firstboot ]]; then
  step 'running first-boot reconciliation now'
  if run /usr/lib/frost/frost-firstboot; then
    note 'hyprlock PAM, snapper and the firewall reconciled'
  else
    note 'first-boot reconciliation reported an issue; it will retry on boot'
  fi
fi

step 'preparing the user account'
if ((has_invoker == 0)); then
  note 'skipped: no invoking user'
else
  # CachyOS gives its first user fish. Frost's shell defaults, prompt and
  # keybindings are written for bash, so the invoking user is moved over — only
  # that user, only to bash, and only when they are not already there.
  status=0
  current_shell=$(getent passwd "$invoker" | cut -d: -f7)
  if [[ $current_shell == */bash ]]; then
    status=10
  else
    try_run chsh -s /bin/bash "$invoker" || status=$?
  fi
  report "$status" \
    "$invoker: $current_shell -> /bin/bash" \
    "$invoker already logs in with bash" \
    "could not change the login shell; do it later with: chsh -s /bin/bash $invoker"

  # The bash package ships /etc/skel/.bashrc, so a new account always has one
  # already and creating the file conditionally never fired. The Frost defaults
  # are appended to whatever is there instead, guarded by the line itself.
  status=0
  try_run su - "$invoker" -s /bin/bash -c '
    set -eu
    rc="$HOME/.bashrc"
    line="'"$BASHRC_LINE"'"
    if [ -f "$rc" ] && grep -qxF "$line" "$rc"; then
      exit 10
    fi
    {
      [ -f "$rc" ] || printf "# Frost. This file is yours to edit.\n"
      printf "\n# Frost defaults: prompt, history and aliases.\n%s\n" "$line"
    } >> "$rc"
  ' || status=$?
  report "$status" \
    "~$invoker/.bashrc now sources the Frost defaults" \
    "~$invoker/.bashrc already sources the Frost defaults" \
    "could not update ~$invoker/.bashrc"

  # CachyOS Hello is copied out of /etc/skel into the user's own autostart
  # directory, so it is their file and no package owns it. Hidden=true is the
  # XDG way to switch an entry off, and deleting that one line brings it back.
  status=0
  try_run su - "$invoker" -s /bin/bash -c '
    set -eu
    entry="$HOME/.config/autostart/cachyos-hello.desktop"
    [ -f "$entry" ] || exit 10
    grep -q "^Hidden=true$" "$entry" && exit 10
    printf "Hidden=true\n" >> "$entry"
  ' || status=$?
  report "$status" \
    'disabled the CachyOS Hello autostart' \
    'CachyOS Hello autostart absent or already disabled' \
    'could not disable the CachyOS Hello autostart'

  # Hide the CachyOS utility apps from the launcher with per-user NoDisplay
  # overrides. Idempotent; only ids that resolve to an installed entry are
  # written, and every id considered is named in the log.
  hidden_desktop_ids=$(printf '%s\n' "${FROST_HIDE_DESKTOP[@]}")
  status=0
  try_run su - "$invoker" -s /bin/bash -c '
    set -eu
    ids="'"$hidden_desktop_ids"'"
    dest="$HOME/.local/share/applications"
    mkdir -p "$dest"
    hidden="" missing=""
    for id in $ids; do
      found=""
      for dir in /usr/share/applications /usr/local/share/applications "$dest"; do
        [ -f "$dir/$id" ] && { found=1; break; }
      done
      [ -n "$found" ] || { missing="$missing $id"; continue; }
      if [ -f "$dest/$id" ] && grep -q "^NoDisplay=true$" "$dest/$id"; then
        continue
      fi
      printf "[Desktop Entry]\nType=Application\nNoDisplay=true\n" > "$dest/$id"
      hidden="$hidden $id"
    done
    [ -z "$hidden" ] || printf "hidden:%s\n" "$hidden"
    [ -z "$missing" ] || printf "not present on this image:%s\n" "$missing"
    command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$dest" >/dev/null 2>&1 || true
    [ -n "$hidden" ] || exit 10
  ' || status=$?
  report "$status" \
    'hid the marked CachyOS apps from the launcher' \
    'no CachyOS launcher entries needed hiding' \
    'could not write the launcher overrides'
fi

step 'building the AUR apps'
# Best effort and never as root: paru comes from the repositories when they
# carry it (CachyOS does) and from its AUR recipe otherwise, built as the
# invoking user. Without an invoker or a network this is skipped with a printed
# hint and the install still succeeds.

aur_apps() {
  { [[ -f $here/aur.lock.json ]] && command -v jq >/dev/null; } || return 0
  jq -r '[.packages[].name]
         | map(select(. != "paru" and test("^[a-z0-9][a-z0-9@._+-]*$")))
         | join(" ")' "$here/aur.lock.json"
}

apps=$(aur_apps)

manual_aur_hint() {
  say 'Finish later, as your user:'
  say "  sudo pacman -S --needed paru   # or build it from https://aur.archlinux.org/paru.git"
  say "  paru -S --needed $apps"
}

# paru escalates through sudo, so the invoking user needs to reach pacman without
# a password. Two things about how sudo reads its rules decide the shape of this:
# the LAST matching rule wins, and /etc/sudoers.d is read in filename order. The
# CachyOS installer leaves /etc/sudoers.d/10-installer holding
# `%wheel ALL=(ALL) ALL`, which matches every command for a user in wheel and
# demands a password — so a grant must sort after it (hence zz-) or it is read
# first and silently loses. paru also runs `sudo -v` before its transaction,
# which a rule naming one command cannot satisfy. So the grant is unqualified.
# It is bounded the other three ways instead: one named user, one file, validated
# before it takes effect, and handed back by the trap on every exit including a
# failure or an interrupt. It exists only while this stage runs.
revoke_pacman_nopasswd() { rm -f -- "$SUDOERS_DROPIN"; }
grant_pacman_nopasswd() {
  local staged
  trap revoke_pacman_nopasswd EXIT
  trap 'revoke_pacman_nopasswd; exit 130' INT TERM
  staged=$(mktemp)
  printf '%s ALL=(root) NOPASSWD: ALL\n' "$invoker" > "$staged"
  visudo -cqf "$staged" || { rm -f -- "$staged"; die 'the generated sudoers drop-in is invalid'; }
  install -m0440 -o root -g root "$staged" "$SUDOERS_DROPIN"
  rm -f -- "$staged"
}

if ((has_invoker == 0)); then
  note 'skipped: no invoking user'
  manual_aur_hint
elif [[ -z $apps ]]; then
  note 'skipped: aur.lock.json lists nothing to build'
elif ! command -v curl >/dev/null || ! curl -sf -I --max-time 15 https://aur.archlinux.org/ >/dev/null 2>&1; then
  note 'skipped: the AUR is not reachable right now'
  manual_aur_hint
else
  grant_pacman_nopasswd
  note "granted $invoker passwordless sudo for this stage only; revoked on exit"

  if ! command -v paru >/dev/null && pacman -Si paru >/dev/null 2>&1; then
    run pacman -S --needed --noconfirm paru || note 'paru is not installable from the repositories'
  fi
  if ! command -v paru >/dev/null; then
    note "building paru from the AUR as $invoker"
    # Only the AUR recipe needs a compiler; the repository build does not.
    try_run pacman -S --needed --noconfirm rust || note 'rust is unavailable; the paru build will likely fail'
    # -s /bin/bash on purpose: su - uses the account's login shell, and a
    # CachyOS user still on fish would be handed this bash script to run.
    try_run su - "$invoker" -s /bin/bash -c '
      set -eu
      d=$(mktemp -d)
      trap "rm -rf -- $d" EXIT
      git clone --depth 1 https://aur.archlinux.org/paru.git "$d/paru"
      cd "$d/paru"
      makepkg -si --noconfirm --needed
    ' || note 'paru failed to build'
  fi

  if command -v paru >/dev/null; then
    note "paru $(paru --version 2>/dev/null | awk 'NR == 1 {print $2}'), building $(wc -w <<<"$apps") apps"
    # One at a time: a single broken recipe must not cost the others.
    for app in $apps; do
      printf '\n-- %s\n' "$app" >&3
      if try_run su - "$invoker" -s /bin/bash -c "paru -S --needed --noconfirm --skipreview -- $app"; then
        aur_installed=$((aur_installed + 1))
      else
        aur_failed+=("$app")
      fi
    done
    note "AUR: $aur_installed/$(wc -w <<<"$apps") installed"
  else
    manual_aur_hint
  fi
  revoke_pacman_nopasswd
fi

step 'verifying'
if command -v frost >/dev/null; then
  if run frost verify; then
    note 'frost verify: every check ok'
  else
    note 'frost verify reported failures; run it inside the session for detail'
  fi
else
  note 'the frost command is not on PATH — the install did not complete'
fi

step 'done'
if ((${#aur_failed[@]})); then
  say "these AUR apps did not build: ${aur_failed[*]}"
  say "retry as your user with: paru -S --needed ${aur_failed[*]}"
fi
say "Log:   $LOG_FILE"
say 'Check: frost-report (after logging into the Frost session)'
say 'Reboot into Frost.'
