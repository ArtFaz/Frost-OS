#!/bin/bash
# Read-only state report for a Frost install. Run it as the desktop user, in a
# Frost session when you can (some checks read session state):
#
#   ./frost-report            # human-readable, paste the output
#
# It writes nothing and changes nothing. Everything it prints comes from the
# package database, the installed manifests, the user's own state and systemd.

set -uo pipefail
export LC_ALL=C

section() { printf '\n=== %s\n' "$1"; }
kv() { printf '  %-28s %s\n' "$1" "${2:-—}"; }

manifest=/usr/share/doc/frost-meta/manifest.txt
lock=$(ls -1 "$HOME"/frost-install-bundle/aur.lock.json /root/frost-install-bundle/aur.lock.json 2>/dev/null | head -1)

printf 'Frost install report — %s\n' "$(date -Is)"

section 'system'
kv 'os' "$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-unknown}")"
kv 'kernel' "$(uname -r)"
kv 'root filesystem' "$(findmnt -n -o FSTYPE / 2>/dev/null)"
kv 'login shell' "$(getent passwd "$USER" | cut -d: -f7)"
kv 'user' "$USER"

section 'frost'
kv 'frost version' "$(frost version 2>/dev/null)"
for pkg in frost frost-settings frost-meta frost-wallpapers frost-keyring; do
  kv "$pkg" "$(pacman -Q "$pkg" 2>/dev/null | awk '{print $2}')"
done

section 'frost doctor'
frost doctor 2>&1 | sed 's/^/  /'

section 'session'
kv 'XDG_CURRENT_DESKTOP' "${XDG_CURRENT_DESKTOP:-}"
kv 'XDG_SESSION_TYPE' "${XDG_SESSION_TYPE:-}"
kv 'wayland sessions' "$(ls /usr/share/wayland-sessions/ 2>/dev/null | tr '\n' ' ')"
for unit in frost-session.target frost-theme.service frost-shell.service \
            frost-notifications.service frost-polkit.service frost-idle.service \
            frost-clipboard-text.service frost-clipboard-image.service; do
  kv "$unit" "$(systemctl --user is-active "$unit" 2>/dev/null)"
done
if [[ $(systemctl --user is-active frost-shell.service 2>/dev/null) != active ]]; then
  printf '\n  -- last frost-shell output --\n'
  journalctl --user -u frost-shell.service -b --no-pager 2>/dev/null | tail -15 | sed 's/^/  /'
fi

section 'theme and wallpaper'
kv 'selected theme' "$(cat "$HOME/.config/frost/theme" 2>/dev/null)"
kv 'materialised' "$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/frost/theme/origin.json" 2>/dev/null)"
kv 'background state' "$(ls -l "$HOME/.local/state/frost/background.json" 2>/dev/null | awk '{print $5" bytes, "$6" "$7" "$8}')"
kv 'gtk color-scheme' "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)"
kv 'gtk theme' "$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null)"
kv 'gtk3 settings.ini' "$([[ -f $HOME/.config/gtk-3.0/settings.ini ]] && echo present || echo absent)"
kv 'gtk4 settings.ini' "$([[ -f $HOME/.config/gtk-4.0/settings.ini ]] && echo present || echo absent)"
kv 'emoji fonts' "$(fc-list 2>/dev/null | grep -ci emoji)"

section 'packages from the manifest'
if [[ -r $manifest ]]; then
  mapfile -t expected < <(sed -n '/^depends:/,$p' "$manifest" | tail -n +2 | tr -d ' ' | grep -v '^$')
  missing=()
  for pkg in "${expected[@]}"; do
    pacman -Q "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
  done
  kv 'expected' "${#expected[@]}"
  kv 'missing' "${#missing[@]}"
  ((${#missing[@]})) && printf '  %s\n' "${missing[@]}"
else
  kv 'manifest' "not found at $manifest"
fi

section 'AUR packages'
kv 'installed (pacman -Qm)' "$(pacman -Qm 2>/dev/null | wc -l)"
pacman -Qm 2>/dev/null | sed 's/^/  /'
if [[ -n $lock && -r $lock ]]; then
  mapfile -t wanted < <(jq -r '.packages[].name' "$lock" 2>/dev/null)
  absent=()
  for pkg in "${wanted[@]}"; do
    pacman -Q "$pkg" >/dev/null 2>&1 || absent+=("$pkg")
  done
  printf '\n'
  kv 'aur.lock.json' "$lock"
  kv 'locked' "${#wanted[@]}"
  kv 'not installed' "${#absent[@]}"
  ((${#absent[@]})) && printf '  %s\n' "${absent[@]}"
else
  kv 'aur.lock.json' 'not found (pass the bundle directory if it is elsewhere)'
fi

section 'bootstrap log'
if [[ -r /var/log/frost-bootstrap.log ]]; then
  kv 'runs' "$(grep -c '^=== bootstrap-cachyos' /var/log/frost-bootstrap.log)"
  printf '  -- stages --\n'
  grep -E '^== ' /var/log/frost-bootstrap.log | sed 's/^/  /' | tail -20
  printf '  -- AUR outcome --\n'
  grep -E 'did not build|not reachable|skipping|paru|^-- ' /var/log/frost-bootstrap.log | tail -25 | sed 's/^/  /'
else
  kv 'log' '/var/log/frost-bootstrap.log unreadable (try with sudo)'
fi

printf '\n=== end of report\n'
