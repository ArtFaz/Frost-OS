#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
  printf 'package contract: %s\n' "$1" >&2
  exit 1
}

# A donor endpoint is forbidden in any file, prose included: nothing in this repo
# should point a build or a reader at a donor host.
if rg -n -i '(pkgs\.omarchy|github\.com/basecamp|omarchy\.org|omarchy\.manual)' \
  "$root/pkgbuilds" "$root/tools" --glob '!validate-package-config'; then
  fail 'donor endpoint found in package source'
fi

# A bare donor identity is forbidden in build source (PKGBUILD, .install, scripts,
# keyring data). Exemptions, none of which is a package build input:
#   *.md                      documentation; provenance notes name the donor, as
#                             frost/docs/provenance.md does.
#   tools/package-selector/   the package decision aid. Its inventory records the
#                             donor lists as evidence and classifies donor
#                             package names (omarchy-keyring, omarchy-nvim) as
#                             DROP. frost-meta consumes the exported manifest,
#                             never this directory.
if rg -n -i '(omarchy|omacom)' \
  "$root/pkgbuilds" "$root/tools" \
  --glob '!validate-package-config' --glob '!*.md' --glob '!**/package-selector/**'; then
  fail 'donor identity found in package build source'
fi

if rg -n --glob PKGBUILD '(^|[[:space:]])source=.*(git\+|https?://)' "$root/pkgbuilds/frost"; then
  fail 'frost runtime package must build from the explicit local archive'
fi

if [[ ! -f $root/pkgbuilds/frost/PKGBUILD ]]; then
  fail 'frost PKGBUILD is missing'
fi
if [[ ! -f $root/pkgbuilds/frost-keyring/PKGBUILD ]]; then
  fail 'frost-keyring PKGBUILD is missing'
fi

for required_dependency in \
  hyprland uwsm mako hyprlock hypridle hyprpolkitagent hyprpicker ghostty wl-clipboard cliphist curl jq libnotify \
  networkmanager bluez upower power-profiles-daemon wireplumber brightnessctl quickshell \
  grim slurp hyprsunset \
  ttf-jetbrains-mono ttf-nerd-fonts-symbols-mono noto-fonts-emoji; do
  if ! rg -q "^[[:space:]]*'${required_dependency}'$" "$root/pkgbuilds/frost/PKGBUILD"; then
    fail "missing fixed Frost runtime dependency: $required_dependency"
  fi
done

if rg -n '(default|graphical-session)\.target\.wants|systemctl[[:space:]]+--user[[:space:]]+enable' \
  "$root/pkgbuilds/frost"; then
  fail 'Frost package may not globally enable session services'
fi

# frost-meta and frost-settings are allowed from Phase 6 on (Gate 5 closed,
# frost/docs/phase6-integration.md). frost-settings is still installed only by
# the clean install, not enabled here.

# frost-meta is generated, never hand-written: its first line must say so.
if [[ -f $root/pkgbuilds/frost-meta/PKGBUILD ]]; then
  head -1 "$root/pkgbuilds/frost-meta/PKGBUILD" | rg -q '^# Generated by tools/generate-frost-meta' \
    || fail 'frost-meta/PKGBUILD is not the generated file'
fi

# frost-settings must not claim ownership of another package's file.
if [[ -f $root/pkgbuilds/frost-settings/PKGBUILD ]]; then
  if rg -n 'pkgdir.*(etc/pam\.d/hyprlock|etc/conf\.d/snapper|etc/sddm\.conf"|etc/sddm\.conf$)' \
    "$root/pkgbuilds/frost-settings/PKGBUILD"; then
    fail 'frost-settings installs a path owned by another package'
  fi
fi

printf '%s\n' 'package contract: ok'
