#!/bin/bash

set -euo pipefail

frost_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
preview_dir=$(mktemp -d /tmp/frost-island-preview.XXXXXX)
shell_was_running=false
preview_namespace=frost-island
preview_surface_namespace=frost-surfaces
preview_osd_namespace=frost-osd
preview_rule_name=frost-island-preview-$$
source_shell=$frost_root/shell
preview_entry=$source_shell/shell.qml

case ${1:-} in
  "") ;;
  --upstream)
    [[ $# == 2 && -f $2/quickshell/shell.qml ]] || {
      printf '%s\n' 'usage: preview-shell [--upstream /path/to/DynamicGlacier]' >&2
      exit 2
    }
    source_shell=$2/quickshell
    preview_entry=$preview_dir/shell/shell.qml
    preview_namespace=quickshell:dynamic-glacier
    ;;
  *)
    printf '%s\n' 'usage: preview-shell [--upstream /path/to/DynamicGlacier]' >&2
    exit 2
    ;;
esac

case $preview_dir in
  /tmp/frost-island-preview.*) ;;
  *) printf '%s\n' 'frost preview: unsafe temporary path' >&2; exit 1 ;;
esac

cleanup() {
  /usr/bin/hyprctl eval "local rule = rawget(_G, 'frost_island_preview_rule'); if rule ~= nil and rule.destroy ~= nil then rule:destroy() end; _G.frost_island_preview_rule = nil" >/dev/null 2>&1 || true
  /usr/bin/hyprctl eval "local rule = rawget(_G, 'frost_surfaces_preview_rule'); if rule ~= nil and rule.destroy ~= nil then rule:destroy() end; _G.frost_surfaces_preview_rule = nil" >/dev/null 2>&1 || true
  /usr/bin/hyprctl eval "local rule = rawget(_G, 'frost_osd_preview_rule'); if rule ~= nil and rule.destroy ~= nil then rule:destroy() end; _G.frost_osd_preview_rule = nil" >/dev/null 2>&1 || true
  if [[ $shell_was_running == true ]]; then
    systemctl --user start frost-shell.service >/dev/null 2>&1 || true
  fi
  case $preview_dir in
    /tmp/frost-island-preview.*) rm -rf -- "$preview_dir" ;;
  esac
}
trap cleanup EXIT INT TERM

# The installed shell owns the same frost-island / frost-surfaces / frost-osd
# namespaces this preview claims, so it has to step aside first. It comes back
# on exit; frost-shell.service is PartOf= (not BindsTo=) the session target and
# Restart=on-failure, so a manual stop/start does not cascade.
if systemctl --user is-active --quiet frost-shell.service; then
  shell_was_running=true
  systemctl --user stop frost-shell.service
fi

cargo build --quiet --manifest-path "$frost_root/cli/Cargo.toml"
mkdir -p -- "$preview_dir/config" "$preview_dir/state" "$preview_dir/cache" "$preview_dir/runtime"
chmod 0700 "$preview_dir/runtime"

if [[ $source_shell != "$frost_root/shell" ]]; then
  cp -a -- "$source_shell" "$preview_dir/shell"
fi

/usr/bin/hyprctl eval "_G.frost_island_preview_rule = hl.layer_rule({ name = '$preview_rule_name', match = { namespace = '^${preview_namespace//:/\\:}$' }, blur = true, blur_popups = true, ignore_alpha = 0.12, xray = false, animation = 'layers' })" >/dev/null
/usr/bin/hyprctl eval "_G.frost_osd_preview_rule = hl.layer_rule({ name = '$preview_rule_name-osd', match = { namespace = '^${preview_osd_namespace}$' }, blur = true, blur_popups = true, ignore_alpha = 0.12, xray = false, animation = 'layers' })" >/dev/null
/usr/bin/hyprctl eval "_G.frost_surfaces_preview_rule = hl.layer_rule({ name = '$preview_rule_name-surfaces', match = { namespace = '^${preview_surface_namespace}$' }, blur = true, blur_popups = true, ignore_alpha = 0.12, xray = false, animation = 'layers' })" >/dev/null

printf 'Frost Island preview running from %s\n' "$preview_entry"
printf '%s\n' 'Blur is active for this preview; frost-shell.service and layer rules will be restored on exit.'
if [[ $preview_namespace == quickshell:dynamic-glacier ]]; then
  printf '%s\n' 'Upstream mode is isolated and does not run install.sh or change autostart.'
fi

FROST_PREVIEW=1 \
FROST_SOURCE_ROOT="$frost_root" \
FROST_CLI="$frost_root/cli/target/debug/frost" \
XDG_CONFIG_HOME="$preview_dir/config" \
XDG_STATE_HOME="$preview_dir/state" \
XDG_CACHE_HOME="$preview_dir/cache" \
XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-$preview_dir/runtime} \
quickshell --no-color --path "$preview_entry"
