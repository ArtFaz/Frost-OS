#!/bin/bash
# Turn a freshly installed CachyOS Minimal into a Frost system. Run with sudo
# from inside the extracted frost-install-bundle directory:
#
#   sudo ./bootstrap-cachyos
#
# The Frost packages come from a signed repository carried in the bundle and
# need no network. After that, if a network is up, it also bootstraps paru and
# builds the AUR apps from aur.lock.json as the invoking user — best effort:
# a failure there is reported but does not abort the install.
#
# The only packages it removes are the CachyOS-base audio/system providers that
# collide with Frost's PipeWire stack (jack2, pulseaudio*, sudo-rs, ...); the
# exhaustive list is FROST_REPLACES below and any leftover conflict is resolved
# by --ask=4 on the install. Nothing else is removed.

set -euo pipefail
export LC_ALL=C

readonly FROST_FPR=9F8D63165ACC27A4FDCCED02FD40A38811EDD104
readonly REPO_DEST=/var/lib/frost/repo
readonly PACKAGES=(frost-keyring frost frost-settings frost-meta)

# CachyOS Minimal ships alternative providers that Conflict/Replace packages the
# Frost set pulls in — chiefly the PipeWire audio stack and plain `sudo`. Each
# name here is removed (if installed) so the Frost provider can take over; this
# swap is the only removal the script performs. install-contract pins the list.
readonly FROST_REPLACES=(
  jack2 jack pipewire-jack-client                 # -> pipewire-jack
  pulseaudio pulseaudio-alsa pulseaudio-bluetooth # -> pipewire-pulse / pipewire-alsa
  pulseaudio-jack pulseaudio-equalizer-ladspa
  pulseaudio-rtp pulseaudio-zeroconf pulseaudio-lirc
  pipewire-media-session                          # -> wireplumber
  sudo-rs                                         # CachyOS variant provides/conflicts sudo -> sudo
  virtualbox-guest-utils-nox                      # -> virtualbox-guest-utils
)

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

die() { printf 'bootstrap-cachyos: %s\n' "$1" >&2; exit 1; }
step() { printf '\n== %s\n' "$1"; }

[[ $EUID -eq 0 ]] || die 'run as root (sudo ./bootstrap-cachyos)'
command -v pacman >/dev/null || die 'pacman not found — this is not an Arch/CachyOS base'
command -v pacman-key >/dev/null || die 'pacman-key not found'
[[ -f $here/frost.gpg ]] || die 'frost.gpg is not next to this script'
[[ -d $here/repo/x86_64 ]] || die 'repo/x86_64 is not next to this script'

if [[ $(findmnt -n -o FSTYPE / 2>/dev/null || true) != btrfs ]]; then
  printf 'bootstrap-cachyos: note — root is not Btrfs; snapshots and rollback will be unavailable.\n'
fi

step 'trusting the Frost signing key'
pacman-key --add "$here/frost.gpg"
pacman-key --lsign-key "$FROST_FPR"

step 'installing the Frost repository under '"$REPO_DEST"
install -d -m0755 "$REPO_DEST"
cp -a "$here/repo/x86_64" "$REPO_DEST/"
if ! grep -q '^\[frost\]' /etc/pacman.conf; then
  cat >> /etc/pacman.conf <<EOF

[frost]
SigLevel = Required
Server = file://$REPO_DEST/\$arch
EOF
  printf 'added the [frost] repository to /etc/pacman.conf\n'
fi

step 'installing Frost'
pacman -Sy --noconfirm

# Drop base providers Frost replaces, so the install does not stop on a
# conflict. Only names from the fixed FROST_REPLACES list, and only when a
# package is installed under that exact name — `pacman -Q <name>` also matches
# a *provider* (jack2 provides jack), which -Rdd cannot then remove.
mapfile -t installed_pkgs < <(pacman -Qq)
declare -A is_installed=()
for pkg in "${installed_pkgs[@]}"; do is_installed[$pkg]=1; done
present=()
for pkg in "${FROST_REPLACES[@]}"; do
  [[ -n ${is_installed[$pkg]:-} ]] && present+=("$pkg")
done
if ((${#present[@]})); then
  printf 'removing base providers Frost replaces: %s\n' "${present[*]}"
  pacman -Rdd --noconfirm "${present[@]}"
fi

# --ask=4 auto-answers "yes" to any remaining conflict question (--noconfirm
# alone answers "no" and aborts), covering base collisions not in the list.
pacman -S --needed --noconfirm --ask=4 base-devel git rust "${PACKAGES[@]}"

step 'reconciling the initramfs hooks'
HOOKS_CHANGED=0
add_hook() {
  local hook=$1 after=$2 conf=/etc/mkinitcpio.conf
  if grep -qE "^HOOKS=.*\b${hook}\b" "$conf"; then
    return 0
  fi
  if grep -qE "^HOOKS=.*\b${after}\b" "$conf"; then
    sed -i -E "s/^(HOOKS=\(.*\b${after}\b)/\1 ${hook}/" "$conf"
  else
    sed -i -E "s/^(HOOKS=\()/\1${hook} /" "$conf"
  fi
  HOOKS_CHANGED=1
  printf 'added %s hook\n' "$hook"
}
add_hook plymouth keyboard
add_hook btrfs filesystems
if ((HOOKS_CHANGED)); then
  mkinitcpio -P
fi

step 'enabling the display manager and first-boot reconciliation'
systemctl enable sddm.service
systemctl enable frost-firstboot.service

if [[ -x /usr/lib/frost/frost-firstboot ]]; then
  step 'running first-boot reconciliation now'
  /usr/lib/frost/frost-firstboot || printf 'first-boot reconciliation reported an issue; it will retry on boot\n'
fi

step 'building the AUR apps'
# Best effort and never as root: paru is built from its AUR recipe as the
# invoking user, then it installs the rest of aur.lock.json. If there is no
# unprivileged invoker or no network, this is skipped with a printed hint and
# the install still succeeds.

aur_apps() {
  { [[ -f $here/aur.lock.json ]] && command -v jq >/dev/null; } || return 0
  jq -r '[.packages[].name] | map(select(. != "paru")) | join(" ")' "$here/aur.lock.json"
}

manual_aur_hint() {
  printf 'Finish later, as your user:\n'
  printf '  git clone https://aur.archlinux.org/paru.git && (cd paru && makepkg -si)\n'
  printf '  paru -S --needed %s\n' "$(aur_apps)"
}

invoker=${SUDO_USER:-}
if [[ -z $invoker || $invoker == root ]] || ! id -u "$invoker" >/dev/null 2>&1; then
  printf 'no unprivileged invoking user (use sudo, not a root shell) — skipping.\n'
  manual_aur_hint
elif ! command -v curl >/dev/null || ! curl -sf -I --max-time 15 https://aur.archlinux.org/ >/dev/null 2>&1; then
  printf 'the AUR is not reachable right now — skipping.\n'
  manual_aur_hint
else
  if ! command -v paru >/dev/null; then
    printf 'building paru from the AUR as %s\n' "$invoker"
    su - "$invoker" -c '
      set -eu
      d=$(mktemp -d)
      trap "rm -rf -- $d" EXIT
      git clone --depth 1 https://aur.archlinux.org/paru.git "$d/paru"
      cd "$d/paru"
      makepkg -si --noconfirm --needed
    ' || printf 'paru failed to build.\n'
  fi
  if command -v paru >/dev/null; then
    apps=$(aur_apps)
    if [[ -n ${apps:-} ]]; then
      printf 'installing the AUR apps: %s\n' "$apps"
      su - "$invoker" -c "paru -S --needed --noconfirm $apps" \
        || printf 'some AUR apps did not build; finish with: paru -S --needed %s\n' "$apps"
    fi
  else
    manual_aur_hint
  fi
fi

step 'done'
printf 'Reboot into Frost.\n'
