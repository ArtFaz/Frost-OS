#!/bin/bash
# Turn a freshly installed CachyOS Minimal into a Frost system. Run with sudo
# from inside the extracted frost-install-bundle directory:
#
#   sudo ./bootstrap-cachyos
#
# The Frost packages come from a signed repository carried in the bundle; the
# rest of the set comes from the CachyOS repositories, so a network is required.
# The whole run is appended to /var/log/frost-bootstrap.log, and every stage is
# idempotent: re-running it on a half-finished machine is the way to repair it.
#
# What it changes: pacman trust and configuration, the base providers Frost
# replaces (FROST_REPLACES), the package set, the SDDM and frost-firstboot units,
# and — only while the AUR apps build — one sudoers drop-in for the invoking
# user. The initramfs, the boot splash and the bootloader are left exactly as
# CachyOS configured them.

set -euo pipefail
export LC_ALL=C

readonly FROST_FPR=9F8D63165ACC27A4FDCCED02FD40A38811EDD104
readonly REPO_DEST=/var/lib/frost/repo
readonly LOG_FILE=/var/log/frost-bootstrap.log
readonly SUDOERS_DROPIN=/etc/sudoers.d/zz-frost-bootstrap
readonly MIN_FREE_KIB=$((15 * 1024 * 1024))
readonly PACKAGES=(frost-keyring frost frost-settings frost-meta)

# The providers Frost chooses, installed as their own transaction before
# anything that depends on them. Without this, pacman resolves each virtual
# dependency on its own and --noconfirm accepts the first candidate: `jack`
# would come from jack2 (unresolvable against the pipewire-jack that frost-meta
# requires), `vulkan-driver` from an NVIDIA stack, `ttf-font` from
# gnu-free-fonts and `tessdata` from the Afrikaans model. Every name here is a
# deliberate choice; the comment names the virtual it settles.
readonly FROST_PROVIDERS=(
  pipewire pipewire-alsa pipewire-jack pipewire-pulse # jack
  wireplumber                                         # pipewire-session-manager
  mesa lib32-mesa                                     # opengl-driver, lib32-opengl-driver
  vulkan-radeon lib32-vulkan-radeon                   # vulkan-driver
  ttf-dejavu                                          # ttf-font
  tesseract-data-eng                                  # tessdata
  openbsd-netcat                                      # netcat
  sudo                                                # takes over from sudo-rs
)

# CachyOS Minimal ships alternative providers that Conflict/Replace packages the
# Frost set pulls in. Each name here is removed when installed under that exact
# name, so the Frost provider can take over; this swap is the only removal the
# script performs. `sudo-rs` is deliberately absent: pacman swaps it for `sudo`
# within a transaction, so the machine is never left without /usr/bin/sudo.
readonly FROST_REPLACES=(
  jack2 jack pipewire-jack-client                 # -> pipewire-jack
  pulseaudio pulseaudio-alsa pulseaudio-bluetooth # -> pipewire-pulse / pipewire-alsa
  pulseaudio-jack pulseaudio-equalizer-ladspa
  pulseaudio-rtp pulseaudio-zeroconf pulseaudio-lirc
  pipewire-media-session                          # -> wireplumber
  virtualbox-guest-utils-nox                      # -> virtualbox-guest-utils
)

# Names that must not appear in the resolved plan: a provider Frost rejected, or
# a second kernel dragged in by one. Checked before the install runs, so a bad
# resolution costs a message instead of a half-installed system.
readonly FROST_UNWANTED='^(jack2|pulseaudio|pipewire-media-session|nvidia(-[0-9a-z]+)?-utils|linux(-lts|-zen|-hardened)?)$'

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
invoker=${SUDO_USER:-}
aur_failed=()

die() { printf 'bootstrap-cachyos: %s\n' "$1" >&2; exit 1; }
step() { printf '\n== %s\n' "$1"; }
note() { printf '   %s\n' "$1"; }

[[ $EUID -eq 0 ]] || die 'run as root (sudo ./bootstrap-cachyos)'

exec > >(tee -a "$LOG_FILE") 2>&1
printf '\n=== bootstrap-cachyos %s\n' "$(date -Is)"

step 'preflight'
command -v pacman >/dev/null || die 'pacman not found — this is not an Arch/CachyOS base'
command -v pacman-key >/dev/null || die 'pacman-key not found'
command -v pacman-conf >/dev/null || die 'pacman-conf not found'
[[ $(uname -m) == x86_64 ]] || die "the Frost repository is x86_64 only (this is $(uname -m))"
[[ -f $here/frost.gpg ]] || die 'frost.gpg is not next to this script'
[[ -d $here/repo/x86_64 ]] || die 'repo/x86_64 is not next to this script'

# lib32-mesa is part of the set, so multilib is not optional.
pacman-conf --repo-list | grep -qx multilib \
  || die 'the [multilib] repository is disabled — enable it in /etc/pacman.conf, then re-run'

free_kib=$(df -kP / | awk 'NR == 2 { print $4 }')
((free_kib >= MIN_FREE_KIB)) \
  || die "not enough free space on / ($((free_kib / 1024 / 1024)) GiB, need $((MIN_FREE_KIB / 1024 / 1024)) GiB)"

if [[ $(findmnt -n -o FSTYPE / 2>/dev/null || true) != btrfs ]]; then
  note 'root is not Btrfs; snapshots and rollback will be unavailable.'
fi
note "$(df -h / | awk 'NR == 2 { print $4 }') free on /"

step 'trusting the Frost signing key'
pacman-key --add "$here/frost.gpg" || die 'could not import frost.gpg into the pacman keyring'
pacman-key --lsign-key "$FROST_FPR" || note 'the Frost key was already trusted'

step "installing the Frost repository under $REPO_DEST"
install -d -m0755 "$REPO_DEST"
# Replace rather than copy into: cp -a of a directory onto an existing one of
# the same name nests it, and a second run would build up repo/x86_64/x86_64.
rm -rf -- "${REPO_DEST:?}/x86_64"
install -d -m0755 "$REPO_DEST/x86_64"
cp -a "$here/repo/x86_64/." "$REPO_DEST/x86_64/"
if ! grep -q '^\[frost\]' /etc/pacman.conf; then
  cat >> /etc/pacman.conf <<EOF

[frost]
SigLevel = Required
Server = file://$REPO_DEST/\$arch
EOF
  note 'added the [frost] repository to /etc/pacman.conf'
fi

step 'updating the base system'
# A full upgrade, not just a refresh: installing new packages against a stale
# base is a partial upgrade, which Arch and CachyOS do not support. Keyrings go
# first so the upgrade can verify what it downloads on an older image.
pacman -Sy --noconfirm || die 'could not refresh the package databases — check the network and the mirrorlist'
keyrings=()
for keyring in archlinux-keyring cachyos-keyring; do
  pacman -Si "$keyring" >/dev/null 2>&1 && keyrings+=("$keyring")
done
if ((${#keyrings[@]})); then
  pacman -S --needed --noconfirm "${keyrings[@]}" || die 'the keyring update failed'
fi
pacman -Syu --noconfirm || die 'the base system upgrade failed; resolve it and re-run'

step 'swapping the base providers Frost replaces'
# Only names from the fixed FROST_REPLACES list, and only when a package is
# installed under that exact name — `pacman -Q <name>` also matches a *provider*
# (jack2 provides jack), which -Rdd cannot then remove.
mapfile -t installed_pkgs < <(pacman -Qq)
declare -A is_installed=()
for pkg in "${installed_pkgs[@]}"; do is_installed[$pkg]=1; done
present=()
for pkg in "${FROST_REPLACES[@]}"; do
  [[ -n ${is_installed[$pkg]:-} ]] && present+=("$pkg")
done
if ((${#present[@]})); then
  note "removing: ${present[*]}"
  pacman -Rdd --noconfirm "${present[@]}"
else
  note 'nothing to replace'
fi

step 'installing the providers Frost chooses'
# --ask=4 auto-answers "yes" to a conflict with an installed package
# (--noconfirm alone answers "no" and aborts).
pacman -S --needed --noconfirm --ask=4 "${FROST_PROVIDERS[@]}" \
  || die 'the provider transaction failed; the log above names the conflict'

step 'checking the resolved plan'
targets=(base-devel git "${PACKAGES[@]}")
plan=$(pacman -S --needed --print --print-format '%n' "${targets[@]}") \
  || die 'the Frost package set does not resolve; the log above names the conflict'
unwanted=$(grep -xE "$FROST_UNWANTED" <<<"$plan" || true)
[[ -z $unwanted ]] \
  || die "the resolved plan pulls in packages Frost replaces: $(tr '\n' ' ' <<<"$unwanted")"
note "$(grep -c . <<<"$plan") packages to install or upgrade"

step 'installing Frost'
pacman -S --needed --noconfirm --ask=4 "${targets[@]}" || die 'the Frost install failed'

step 'enabling the display manager and first-boot reconciliation'
systemctl enable --force sddm.service || die 'could not enable sddm'
systemctl enable frost-firstboot.service || die 'could not enable frost-firstboot'

if [[ -x /usr/lib/frost/frost-firstboot ]]; then
  step 'running first-boot reconciliation now'
  /usr/lib/frost/frost-firstboot || note 'first-boot reconciliation reported an issue; it will retry on boot'
fi

step 'preparing the user account'
# CachyOS gives its first user fish. Frost's shell defaults, prompt and
# keybindings are written for bash, so the invoking user is moved over — only
# that user, only to bash, and only when they are not already there.
if [[ -z $invoker ]] || ! id -u "$invoker" >/dev/null 2>&1; then
  note 'no invoking user — leaving the login shell alone'
else
  current_shell=$(getent passwd "$invoker" | cut -d: -f7)
  if [[ $current_shell == */bash ]]; then
    note "$invoker already logs in with bash"
  elif chsh -s /bin/bash "$invoker"; then
    note "$invoker: $current_shell -> /bin/bash"
  else
    note "could not change the login shell; do it later with: chsh -s /bin/bash $invoker"
  fi
  # Arriving from fish there is usually no ~/.bashrc at all, and bash then
  # starts bare. Created only when missing: an existing one is the user's.
  su - "$invoker" -s /bin/bash -c '
    set -eu
    [ -f "$HOME/.bashrc" ] && exit 0
    printf "# Frost defaults. This file is yours to edit.\n. /usr/share/frost/default/bash/bashrc\n" > "$HOME/.bashrc"
  ' && note "seeded ~$invoker/.bashrc from the Frost defaults" \
    || note 'left the existing ~/.bashrc alone'

  # CachyOS Hello is copied out of /etc/skel into the user's own autostart
  # directory, so it is their file and no package owns it. Hidden=true is the
  # XDG way to switch an entry off, and deleting that one line brings it back.
  su - "$invoker" -s /bin/bash -c '
    set -eu
    entry="$HOME/.config/autostart/cachyos-hello.desktop"
    [ -f "$entry" ] || exit 1
    grep -q "^Hidden=true$" "$entry" && exit 1
    printf "Hidden=true\n" >> "$entry"
  ' && note 'disabled the CachyOS Hello autostart' \
    || note 'CachyOS Hello autostart not present or already disabled'
fi

step 'building the AUR apps'
# Best effort and never as root: paru comes from the repositories when they
# carry it (CachyOS does) and from its AUR recipe otherwise, built as the
# invoking user. If there is no unprivileged invoker or no network, this is
# skipped with a printed hint and the install still succeeds.

aur_apps() {
  { [[ -f $here/aur.lock.json ]] && command -v jq >/dev/null; } || return 0
  jq -r '[.packages[].name]
         | map(select(. != "paru" and test("^[a-z0-9][a-z0-9@._+-]*$")))
         | join(" ")' "$here/aur.lock.json"
}

manual_aur_hint() {
  printf 'Finish later, as your user:\n'
  printf '  sudo pacman -S --needed paru   # or build it from https://aur.archlinux.org/paru.git\n'
  printf '  paru -S --needed %s\n' "$(aur_apps)"
}

# paru escalates through sudo, so the invoking user needs to reach pacman without
# a password. Two things about how sudo reads its rules decide the shape of this:
# the LAST matching rule wins, and /etc/sudoers.d is read in filename order. The
# CachyOS installer leaves /etc/sudoers.d/10-installer holding
# `%wheel ALL=(ALL) ALL`, which matches every command for a user in wheel and
# demands a password — so a grant must sort after it (hence zz-) or it is read
# first and silently loses. paru also runs `sudo -v` before its transaction,
# which a rule naming one command cannot satisfy. So the grant is unqualified. It is bounded the other three ways instead: one
# named user, one file, validated before it takes effect, and handed back by the
# trap on every exit including a failure or an interrupt. It exists only while
# this stage runs. Decision recorded 2026-08-30; the alternative is dropping the
# AUR stage and printing the command for the user to run after first login.
revoke_pacman_nopasswd() { rm -f -- "$SUDOERS_DROPIN"; }
grant_pacman_nopasswd() {
  local staged
  trap revoke_pacman_nopasswd EXIT
  trap 'revoke_pacman_nopasswd; exit 130' INT TERM
  staged=$(mktemp)
  printf '%s ALL=(root) NOPASSWD: ALL\n' "$invoker" > "$staged"
  visudo -cqf "$staged" || { rm -f -- "$staged"; die 'the generated sudoers drop-in is invalid'; }
  install -m0440 -o root -g root "$staged" "$SUDOERS_DROPIN"
  rm -f -- "$staged"
  note "granted $invoker passwordless sudo for this stage only; revoked on exit"
}

apps=$(aur_apps)
if [[ -z $invoker || $invoker == root ]] || ! id -u "$invoker" >/dev/null 2>&1; then
  note 'no unprivileged invoking user (use sudo, not a root shell) — skipping.'
  manual_aur_hint
elif [[ -z $apps ]]; then
  note 'aur.lock.json lists nothing to build — skipping.'
elif ! command -v curl >/dev/null || ! curl -sf -I --max-time 15 https://aur.archlinux.org/ >/dev/null 2>&1; then
  note 'the AUR is not reachable right now — skipping.'
  manual_aur_hint
else
  grant_pacman_nopasswd
  if ! command -v paru >/dev/null && pacman -Si paru >/dev/null 2>&1; then
    note 'installing paru from the repositories'
    pacman -S --needed --noconfirm paru || note 'paru is not installable from the repositories'
  fi
  if ! command -v paru >/dev/null; then
    note "building paru from the AUR as $invoker"
    # Only the AUR recipe needs a compiler; the repository build does not.
    pacman -S --needed --noconfirm rust || note 'rust is unavailable; the paru build will likely fail'
    # -s /bin/bash on purpose: su - uses the account's login shell, and a
    # CachyOS user still on fish would be handed this bash script to run.
    su - "$invoker" -s /bin/bash -c '
      set -eu
      d=$(mktemp -d)
      trap "rm -rf -- $d" EXIT
      git clone --depth 1 https://aur.archlinux.org/paru.git "$d/paru"
      cd "$d/paru"
      makepkg -si --noconfirm --needed
    ' || note 'paru failed to build.'
  fi
  if command -v paru >/dev/null; then
    # One at a time: a single broken recipe must not cost the other fourteen.
    for app in $apps; do
      printf '\n-- %s\n' "$app"
      su - "$invoker" -s /bin/bash -c "paru -S --needed --noconfirm --skipreview -- $app" \
        || aur_failed+=("$app")
    done
  else
    manual_aur_hint
  fi
  revoke_pacman_nopasswd
fi

step 'done'
if ((${#aur_failed[@]})); then
  printf 'these AUR apps did not build: %s\n' "${aur_failed[*]}"
  printf 'retry as your user with: paru -S --needed %s\n' "${aur_failed[*]}"
fi
printf 'Log:   %s\n' "$LOG_FILE"
printf 'Check: frost doctor (after logging into the Frost session)\n'
printf 'Reboot into Frost.\n'
