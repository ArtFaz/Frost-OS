# Package-owned Frost Bash defaults. This file is not copied over user config.

case $- in
    *i*) ;;
    *) return ;;
esac

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

# ~/.local/bin holds user-installed executables and the mise shims; put it on
# PATH ahead of anything that looks for them.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
esac

# mise manages language runtimes and tools; activate it so its shims and
# per-directory environment load for each shell.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

# Readline behaviour: history search on the arrow keys, cycling Tab completion,
# case-insensitive matching. Package-owned; a user's own ~/.inputrc still wins.
if [ -r /usr/share/frost/default/bash/inputrc ]; then
    bind -f /usr/share/frost/default/bash/inputrc
fi

# Programmable completion.
if [ -z "${BASH_COMPLETION_VERSINFO:-}" ] && [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi

# eza replaces ls when it is installed. Plain `ls` stays available under its own
# name through the alias target.
if command -v eza >/dev/null 2>&1; then
    alias ls='eza -lh --group-directories-first --icons=auto'
    alias lsa='ls -a'
    alias lt='eza --tree --level=2 --long --icons --git'
    alias lta='lt -a'
fi

# zoxide learns the directories you visit; `cd` falls through to it on a miss.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
    zd() {
        if (( $# == 0 )); then
            builtin cd ~ || return
        elif [[ -d $1 ]]; then
            builtin cd "$1" || return
        elif ! z "$@"; then
            echo "Error: Directory not found" >&2
            return 1
        else
            printf '\U000F17A9 '
            pwd
        fi
    }
    alias cd='zd'
fi

# fzf key bindings (Ctrl-R history, Ctrl-T files) and completion. When fd is
# present it becomes the file source, so hidden files are searched and .git is
# skipped.
if command -v fzf >/dev/null 2>&1; then
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi
    export FZF_DEFAULT_OPTS='--layout=reverse --border --height=40%'
    [ -r /usr/share/fzf/completion.bash ] && . /usr/share/fzf/completion.bash
    [ -r /usr/share/fzf/key-bindings.bash ] && . /usr/share/fzf/key-bindings.bash
fi

# bat renders man pages when it is present.
if command -v bat >/dev/null 2>&1; then
    export MANROFFOPT='-c'
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# less: keep ANSI colour from paged output, and don't leave a ~/.lesshst behind.
export LESS='-R'
export LESSHISTFILE=-

# Starship draws the prompt with its own default preset (Nerd Font glyphs, no
# Frost config file). The plain PS1 below is only what is left if it is missing.
PS1='\[\e[38;5;110m\]\w\[\e[0m\] \$ '

if [ "${TERM:-}" != "dumb" ] && command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
