# Package-owned Frost Bash defaults. This file is not copied over user config.

case $- in
    *i*) ;;
    *) return ;;
esac

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

# Readline behaviour: history search on the arrow keys, cycling Tab completion,
# case-insensitive matching. Package-owned; a user's own ~/.inputrc still wins.
if [ -r /usr/share/frost/default/bash/inputrc ]; then
    bind -f /usr/share/frost/default/bash/inputrc
fi

# Programmable completion.
if [ -z "${BASH_COMPLETION_VERSINFO:-}" ] && [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi

# eza replaces ls when it is installed. Plain `ls` stays available under its own
# name through the alias target.
if command -v eza >/dev/null 2>&1; then
    alias ls='eza -lh --group-directories-first --icons=auto'
    alias lsa='ls -a'
    alias lt='eza --tree --level=2 --long --icons --git'
    alias lta='lt -a'
fi

# zoxide learns the directories you visit; `cd` falls through to it on a miss.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init bash)"
    zd() {
        if (( $# == 0 )); then
            builtin cd ~ || return
        elif [[ -d $1 ]]; then
            builtin cd "$1" || return
        elif ! z "$@"; then
            echo "Error: Directory not found" >&2
            return 1
        else
            printf '\U000F17A9 '
            pwd
        fi
    }
    alias cd='zd'
fi

# fzf key bindings (Ctrl-R history, Ctrl-T files) and completion.
if command -v fzf >/dev/null 2>&1; then
    [ -r /usr/share/fzf/completion.bash ] && . /usr/share/fzf/completion.bash
    [ -r /usr/share/fzf/key-bindings.bash ] && . /usr/share/fzf/key-bindings.bash
fi

# bat renders man pages when it is present.
if command -v bat >/dev/null 2>&1; then
    export MANROFFOPT='-c'
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# Starship draws the prompt with its own default preset (Nerd Font glyphs, no
# Frost config file). The plain PS1 below is only what is left if it is missing.
PS1='\[\e[38;5;110m\]\w\[\e[0m\] \$ '

if [ "${TERM:-}" != "dumb" ] && command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
fi
