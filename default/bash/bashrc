# Package-owned Frost Bash defaults. This file is not copied over user config.

case $- in
    *i*) ;;
    *) return ;;
esac

HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend checkwinsize

# Starship draws the prompt. The plain PS1 below is only what is left if it is
# missing, so a broken install still gets a usable shell.
PS1='\[\e[38;5;110m\]\w\[\e[0m\] \\$ '

if command -v starship >/dev/null 2>&1; then
    # Frost's own preset, unless the user has written their own.
    if [ -z "${STARSHIP_CONFIG:-}" ] && [ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml" ]; then
        export STARSHIP_CONFIG=/usr/share/frost/default/starship.toml
    fi
    eval "$(starship init bash)"
fi
