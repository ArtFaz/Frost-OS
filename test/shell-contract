#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
shell=$root/shell

fail() { printf 'shell contract: %s\n' "$1" >&2; exit 1; }

for relative_path in \
  shell.qml Core/Config.qml Core/Motion.qml Core/ShellBackend.qml Core/Style.qml Core/Theme.qml \
  Island/AudioIndicator.qml Island/AudioPanel.qml Island/BatteryPanel.qml Island/BluetoothPanel.qml \
  Island/DynamicGlacier.qml Island/FrostGlassSurface.qml Island/IslandContent.qml \
  Island/IslandSurface.qml Island/MIcon.qml Island/PeekStatusRow.qml \
  Island/NotificationsPanel.qml Island/PanelHeader.qml Island/PanelSwitch.qml \
  Island/TrayRail.qml Island/WorkspaceRail.qml \
  Core/Surfaces.qml Surfaces/ClipboardSurface.qml Surfaces/EmojiSurface.qml \
  Surfaces/LauncherSurface.qml Surfaces/SurfaceHost.qml Surfaces/SurfaceSearchField.qml; do
  [[ -f $shell/$relative_path && ! -L $shell/$relative_path ]] || fail "missing Frost Island file: $relative_path"
done

mapfile -t ipc_targets < <(rg --no-filename -o 'target:\s*"[^"]+"' "$shell" --glob '*.qml')
[[ ${#ipc_targets[@]} == 1 && ${ipc_targets[0]} == 'target: "frost"' ]] || fail 'shell must expose exactly one Frost IPC target'
[[ $(rg -c 'PanelWindow\s*\{' "$shell/Island/DynamicGlacier.qml") == 1 ]] || fail 'island must own exactly one PanelWindow'
# The full-screen surfaces share a single host window, so they keep one keyboard
# focus lifetime and one compositor blur rule between them.
[[ $(rg -c 'PanelWindow\s*\{' "$shell/Surfaces/SurfaceHost.qml") == 1 ]] || fail 'surfaces must share exactly one PanelWindow'
rg -Fq 'WlrLayershell.namespace: "frost-surfaces"' "$shell/Surfaces/SurfaceHost.qml" || fail 'stable surface namespace is missing'
rg -Fq 'WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive' "$shell/Surfaces/SurfaceHost.qml" || fail 'surfaces must take exclusive keyboard focus'
# Applications are launched through the desktop-entry API, never a shell string.
rg -Fq '.entry.execute()' "$shell/Surfaces/LauncherSurface.qml" || fail 'launcher must execute desktop entries natively'
rg -Fq 'WlrLayershell.namespace: "frost-island"' "$shell/Island/DynamicGlacier.qml" || fail 'stable island namespace is missing'
rg -Fq 'exclusiveZone: root.reservedZone' "$shell/Island/DynamicGlacier.qml" || fail 'constant island exclusion zone is missing'
rg -Fq 'WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand' "$shell/Island/DynamicGlacier.qml" || fail 'search inputs cannot receive controlled keyboard focus'
rg -Fq 'mask: Region' "$shell/Island/DynamicGlacier.qml" || fail 'island input mask is missing'
for module in Quickshell.Bluetooth Quickshell.Hyprland Quickshell.Services.Mpris Quickshell.Services.Pipewire Quickshell.Services.UPower; do
  rg -Fq "import $module" "$shell/Island/DynamicGlacier.qml" || fail "native service missing: $module"
done
rg -Fq 'import Quickshell.Hyprland' "$shell/Island/WorkspaceRail.qml" || fail 'workspace rail does not use the native Hyprland service'
rg -Fq 'import Quickshell.Services.SystemTray' "$shell/Island/TrayRail.qml" || fail 'background-app rail does not use the native tray service'
rg -Fq 'workspace.activate()' "$shell/Island/WorkspaceRail.qml" || fail 'workspace activation must stay native'
if rg -n 'liquidGlass|LiquidGlass|Material Symbols|mediaToggleFavorite' "$shell/Island"; then
  fail 'optional glass state, external symbols or a dead media action remains'
fi
rg -Fq 'font.family: Style.iconFontFamily' "$shell/Island/MIcon.qml" || fail 'Frost icon font is not used'
rg -Fq 'FrostGlassSurface {' "$shell/Island/IslandSurface.qml" || fail 'Frost material does not own the island body'
rg -Fq '"input": name === "wifi-connect"' "$shell/Core/ShellBackend.qml" || fail 'Wi-Fi secret is not isolated to typed stdin'

# qmllint 1.0 aborts without a diagnostic on any file that imports a Quickshell
# service plugin (Bluetooth, SystemTray, Hyprland, Pipewire), so the linted set is
# every file it can actually analyse rather than a hand-picked pair.
if command -v qmllint >/dev/null; then
  qmllint -I "$shell" \
    "$shell/shell.qml" \
    "$shell"/Core/*.qml \
    "$shell/Island/BatteryPanel.qml" \
    "$shell/Island/FrostGlassSurface.qml" \
    "$shell/Island/IslandContent.qml" \
    "$shell/Island/IslandSurface.qml" \
    "$shell/Island/MIcon.qml" \
    "$shell/Island/NotificationsPanel.qml" \
    "$shell/Island/PanelHeader.qml" \
    "$shell/Island/PanelSwitch.qml" \
    "$shell/Island/PeekStatusRow.qml" \
    "$shell/Surfaces/ClipboardSurface.qml" \
    "$shell/Surfaces/LauncherSurface.qml" \
    "$shell/Surfaces/SurfaceHost.qml" \
    "$shell/Surfaces/SurfaceSearchField.qml"
fi

printf '%s\n' 'shell contract: ok'
