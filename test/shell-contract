#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
shell=$root/shell

fail() {
  printf 'shell contract: %s\n' "$1" >&2
  exit 1
}

for relative_path in \
  shell.qml \
  Core/Config.qml \
  Core/IndicatorState.qml \
  Core/Motion.qml \
  Core/ShellBackend.qml \
  Core/Style.qml \
  Core/SystemState.qml \
  Core/Theme.qml \
  Core/WeatherState.qml \
  Primitives/FocusRing.qml \
  Primitives/GlassSurface.qml \
  Primitives/InteractiveSurface.qml \
  Primitives/ModuleCard.qml \
  Primitives/PanelHeader.qml \
  Primitives/SearchField.qml \
  Primitives/SurfaceButton.qml \
  Primitives/ToggleSwitch.qml \
  Primitives/ValueSlider.qml \
  Bar/Bar.qml \
  Bar/Workspaces.qml \
  Bar/Tray.qml \
  Bar/Clock.qml \
  Osd/Osd.qml \
  Osd/OsdModel.js \
  Surfaces/SurfaceHost.qml \
  Surfaces/WeatherPanel.qml \
  Surfaces/Launcher.qml \
  Surfaces/ControlCenter.qml \
  Surfaces/CalendarPanel.qml \
  Surfaces/MediaCard.qml \
  Surfaces/NetworkPanel.qml \
  Surfaces/BluetoothPanel.qml \
  Surfaces/AudioPanel.qml \
  Surfaces/DisplayPowerPanel.qml \
  Surfaces/ClipboardPanel.qml \
  Surfaces/EmojiPanel.qml \
  Surfaces/ImagePickerPanel.qml \
  Surfaces/AppInstallerPanel.qml \
  Surfaces/InstallerModel.js \
  Surfaces/NotificationPanel.qml \
  Surfaces/NotificationModel.js \
  Surfaces/OptionalPanel.qml \
  Surfaces/ReminderPanel.qml; do
  [[ -f $shell/$relative_path && ! -L $shell/$relative_path ]] ||
    fail "missing static shell file: $relative_path"
done

mapfile -t ipc_targets < <(rg --no-filename -o 'target:\s*"[^"]+"' "$shell" --glob '*.qml')
[[ ${#ipc_targets[@]} == 1 && ${ipc_targets[0]} == 'target: "frost"' ]] ||
  fail 'shell must expose exactly one Frost IPC target'
rg -q '^import Quickshell\.Io$' "$shell/shell.qml" ||
  fail 'IpcHandler must be imported from Quickshell.Io'
if rg -q 'function\s+[^(]+\([^)]*,' "$shell/shell.qml"; then
  fail 'Frost IPC functions must accept at most one argument for QuickShell 0.3.1 compatibility'
fi
rg -q 'ipc call frost showOsd "\$payload"' "$root/bin/frost-osd" ||
  fail 'OSD wrapper must call the single-argument Frost IPC method'

rg -q 'model: root\.enabled \? Quickshell\.screens : \[\]' "$shell/Bar/Bar.qml" ||
  fail 'bar is not composed per screen'
rg -q 'exclusiveZone: Theme\.barHeight' "$shell/Bar/Bar.qml" ||
  fail 'bar does not reserve its exact height'
rg -q 'model: SystemTray\.items' "$shell/Bar/Tray.qml" ||
  fail 'static system tray model is missing'
rg -q 'model: \[1, 2, 3, 4, 5\]' "$shell/Bar/Workspaces.qml" ||
  fail 'fixed workspace composition is missing'
rg -q '^import qs\.Primitives$' "$shell/Bar/Bar.qml" ||
  fail 'bar does not use the static Frost primitive module'
rg -q 'surfaceRole: "bar"' "$shell/Bar/Bar.qml" ||
  fail 'bar does not declare its Frosted Glass role'
rg -q 'surfaceRole: "osd"' "$shell/Osd/Osd.qml" ||
  fail 'OSD does not declare its Frosted Glass role'
rg -q 'InteractiveSurface' "$shell/Bar/Workspaces.qml" ||
  fail 'workspace controls do not use the focusable Frost primitive'
rg -q 'WlrLayershell\.namespace: "frost-surfaces"' "$shell/Surfaces/SurfaceHost.qml" ||
  fail 'complete shell surfaces do not share the Frost namespace'
rg -q 'WlrLayershell\.keyboardFocus: WlrKeyboardFocus\.Exclusive' "$shell/Surfaces/SurfaceHost.qml" ||
  fail 'keyboard-interactive surfaces do not own an explicit focus boundary'
rg -q 'WlrLayershell\.keyboardFocus: WlrKeyboardFocus\.None' "$shell/Bar/Bar.qml" ||
  fail 'bar must remain outside keyboard focus authority'
for surface in launcher control-center calendar weather reminders network bluetooth audio display-power clipboard emoji images app-installer notifications; do
  rg -Fq "\"$surface\"" "$shell/shell.qml" || fail "static surface is not routed: $surface"
done

if command -v qmllint >/dev/null; then
  mapfile -t qml_files < <(find "$shell" -type f -name '*.qml' -print | sort)
  qmllint -I "$shell" "${qml_files[@]}"
fi

if command -v quickshell >/dev/null; then
  smoke_runtime=$(mktemp -d /tmp/frost-core-runtime.XXXXXX)
  case $smoke_runtime in
    /tmp/frost-core-runtime.*) ;;
    *) fail 'invalid Core runtime smoke directory' ;;
  esac
  chmod 0700 "$smoke_runtime"
  if smoke_output=$(env -u QT_QPA_PLATFORMTHEME -u GTK_THEME \
    XDG_RUNTIME_DIR="$smoke_runtime" QT_QPA_PLATFORM=offscreen \
    timeout --signal=TERM --kill-after=1 3 \
    quickshell --no-color --path "$root/test/core-runtime-smoke.qml" 2>&1); then
    smoke_status=0
  else
    smoke_status=$?
  fi
  if ((smoke_status != 0 && smoke_status != 124)) || \
    ! grep -Fq 'Configuration Loaded' <<<"$smoke_output" || \
    grep -Fq 'Failed to load configuration' <<<"$smoke_output"; then
    printf '%s\n' "$smoke_output" >&2
    rm -rf -- "$smoke_runtime"
    fail 'QuickShell cannot instantiate the Frost Core singletons'
  fi
  rm -rf -- "$smoke_runtime"
fi

node --check "$shell/Osd/OsdModel.js"
node --check "$shell/Surfaces/InstallerModel.js"
node --check "$shell/Surfaces/NotificationModel.js"
node "$root/test/osd-model.js"
node "$root/test/phase4-models.js"

printf '%s\n' 'shell contract: ok'
