#!/bin/bash
# frost-meta is generated from frost-packages.json. This checks the committed
# PKGBUILD against the inventory without needing the frost binary: every
# dependency must be a non-AUR, non-BOOTSTRAP inventory package, and the set
# must include frost and frost-settings.

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
pkgbuild="$root/pkgbuilds/frost-meta/PKGBUILD"
inv="$root/tools/package-selector/inventory.json"

fail() { printf 'frost-meta: %s\n' "$1" >&2; exit 1; }

if [[ ! -f $pkgbuild ]]; then
  printf 'frost-meta: not built yet (skipped)\n'
  exit 0
fi

head -1 "$pkgbuild" | rg -q '^# Generated by tools/generate-frost-meta' \
  || fail 'PKGBUILD is not the generated file'
rg -q "^pkgname=frost-meta$" "$pkgbuild" || fail 'wrong pkgname'
rg -q "^arch=\('any'\)$" "$pkgbuild" || fail 'meta package must be arch=any'

mapfile -t deps < <(rg -o "^  '([a-z0-9][a-z0-9@._+-]*)'$" -r '$1' "$pkgbuild" | LC_ALL=C sort)
((${#deps[@]} > 0)) || fail 'no dependencies'

declare -A DEP; for d in "${deps[@]}"; do DEP[$d]=1; done

# Sets from the inventory.
mapfile -t bootstrap < <(jq -r '.packages[] | select(.category == "BOOTSTRAP") | .name' "$inv")
mapfile -t aur < <(jq -r '.packages[] | select(.source == "aur") | .name' "$inv")
mapfile -t known < <(jq -r '.packages[] | select(.source != "aur" and .category != "BOOTSTRAP") | .name' "$inv")
declare -A KNOWN; for k in "${known[@]}"; do KNOWN[$k]=1; done

for b in "${bootstrap[@]}"; do
  [[ -n ${DEP[$b]:-} ]] && fail "BOOTSTRAP package in depends: $b (the CachyOS base owns it)"
done
for a in "${aur[@]}"; do
  [[ -n ${DEP[$a]:-} ]] && fail "AUR package in depends: $a (belongs in aur.lock.json)"
done
for d in "${deps[@]}"; do
  [[ -n ${KNOWN[$d]:-} ]] || fail "dependency not an Arch/Frost inventory package: $d"
done
for required in frost frost-settings; do
  [[ -n ${DEP[$required]:-} ]] || fail "depends is missing $required"
done

# The generator is deterministic: re-running it must not change the file.
if command -v frost >/dev/null 2>&1 && [[ -f $root/../frost/frost-packages.json ]]; then
  tmp=$(mktemp)
  trap 'rm -f -- "$tmp"' EXIT
  cp "$pkgbuild" "$tmp"
  "$root/tools/generate-frost-meta" >/dev/null 2>&1 || true
  if ! diff -q "$tmp" "$pkgbuild" >/dev/null; then
    cp "$tmp" "$pkgbuild"
    fail 'PKGBUILD is stale — re-run tools/generate-frost-meta and commit'
  fi
fi

printf 'frost-meta: ok (%s dependencies)\n' "${#deps[@]}"
