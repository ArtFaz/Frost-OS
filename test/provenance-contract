#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
ledger=$root/docs/provenance/ports.json
data_ledger=$root/docs/provenance/data.json
wallpaper_ledger=$root/docs/provenance/wallpapers.json

fail() {
  printf 'provenance contract: %s\n' "$1" >&2
  exit 1
}

jq -e '
  .schemaVersion == 1 and
  (.entries | type == "array") and
  all(.entries[];
    (.destination | type == "string" and startswith("shell/") and (contains("..") | not)) and
    (.originRepository == "Frost" or
      .originRepository == "Frost-OS" or
      .originRepository == "staging" or
      .originRepository == "https://github.com/mavxa/DynamicGlacier") and
    (.transformation == "original" or
      .transformation == "adapted" or
      .transformation == "rewritten-from-concept") and
    (
      (
        .originRepository == "https://github.com/mavxa/DynamicGlacier" and
        (.originCommit | test("^[0-9a-f]{40}$")) and
        (.originPath | type == "string" and length > 0 and (startswith("/") | not)) and
        (.transformation == "adapted" or .transformation == "rewritten-from-concept") and
        .license == "MIT" and
        .notice == "docs/licenses/DynamicGlacier-MIT.txt"
      ) or
      (
        (.originRepository == "Frost-OS" or .originRepository == "staging") and
        (.originCommit | test("^[0-9a-f]{40}$")) and
        (.originPath | type == "string" and length > 0 and (startswith("/") | not)) and
        (.transformation == "adapted" or .transformation == "rewritten-from-concept") and
        .license == "pending-confirmation" and
        .notice == "docs/provenance.md"
      ) or
      (
        # Frost-authored work with no donor lineage. Recording it as derived
        # from a rights-blocked donor would overstate the publication debt.
        .originRepository == "Frost" and
        .transformation == "original" and
        .originCommit == "" and
        .originPath == "" and
        .license == "Frost project license" and
        .notice == "docs/provenance.md"
      )
    )
  ) and
  ((.entries | map(.destination) | unique | length) == (.entries | length))
' "$ledger" >/dev/null || fail 'ledger schema or entry constraint failed'

while IFS=$'\t' read -r repository commit; do
  case $repository in
    Frost-OS) expected=f4a8cc9cd4137469393f815ccef08a849ce9005d ;;
    staging) expected=824831e75171dc4c87c8d53dfd22e3e07de7f6a6 ;;
    https://github.com/mavxa/DynamicGlacier)
      expected=70824af6350927c429ed57fb83d89ed843e6cd84
      ;;
    Frost) expected= ;;
    *) fail "unknown source repository: $repository" ;;
  esac
  [[ $commit == "$expected" ]] || fail "unfrozen source commit for $repository"
done < <(jq -r '.entries[] | [.originRepository, .originCommit] | @tsv' "$ledger")

while IFS= read -r destination; do
  [[ -f $root/$destination && ! -L $root/$destination ]] ||
    fail "missing regular destination: $destination"
done < <(jq -r '.entries[].destination' "$ledger")

missing=$(comm -23 \
  <(find "$root/shell" -type f \( -name '*.qml' -o -name '*.js' \) -printf '%P\n' | sed 's|^|shell/|' | sort) \
  <(jq -r '.entries[].destination' "$ledger" | sort))
[[ -z $missing ]] || fail "shell implementation lacks provenance: $missing"

extra=$(comm -13 \
  <(find "$root/shell" -type f \( -name '*.qml' -o -name '*.js' \) -printf '%P\n' | sed 's|^|shell/|' | sort) \
  <(jq -r '.entries[].destination' "$ledger" | sort))
[[ -z $extra ]] || fail "ledger destination is not a shell implementation: $extra"

jq -e '
  .schemaVersion == 1 and
  (.entries | type == "array" and length == 1) and
  all(.entries[];
    (.destination | startswith("config/data/") and (contains("..") | not)) and
    .authority == "Frost-authored" and
    (.derivation | type == "string" and length > 0) and
    .license == "Frost project license" and
    .executable == false
  ) and
  ((.entries | map(.destination) | unique | length) == (.entries | length))
' "$data_ledger" >/dev/null || fail 'data provenance ledger is invalid'
while IFS= read -r destination; do
  [[ -f $root/$destination && ! -L $root/$destination && ! -x $root/$destination ]] ||
    fail "missing safe data destination: $destination"
done < <(jq -r '.entries[].destination' "$data_ledger")
missing_data=$(comm -23 \
  <(find "$root/config/data" -type f -printf '%P\n' | sed 's|^|config/data/|' | sort) \
  <(jq -r '.entries[].destination' "$data_ledger" | sort))
[[ -z $missing_data ]] || fail "data file lacks provenance: $missing_data"

# Wallpapers are binary assets whose terms nobody has established, so the ledger
# records where each one came from and that redistribution is blocked. The
# bijection is the point: an image cannot enter the tree without a record, and a
# record cannot outlive its image.
if [[ -d $root/backgrounds ]]; then
  jq -e '
    .schemaVersion == 1 and
    (.entries | type == "array") and
    all(.entries[];
      (.destination | type == "string" and startswith("backgrounds/") and (contains("..") | not)) and
      (.originRepository | type == "string" and length > 0) and
      (.originCommit | test("^[0-9a-f]{40}$")) and
      (.originPath | type == "string" and length > 0) and
      (.sha256 | test("^[0-9a-f]{64}$")) and
      (.license | type == "string" and length > 0) and
      (.redistribution == "blocked" or .redistribution == "cleared"))
  ' "$wallpaper_ledger" >/dev/null || fail 'wallpaper provenance ledger is invalid'

  while IFS= read -r destination; do
    [[ -f $root/$destination && ! -L $root/$destination && ! -x $root/$destination ]] ||
      fail "missing safe wallpaper destination: $destination"
  done < <(jq -r '.entries[].destination' "$wallpaper_ledger")

  missing_wallpapers=$(comm -23 \
    <(find "$root/backgrounds" -type f -printf '%P\n' | sed 's|^|backgrounds/|' | sort) \
    <(jq -r '.entries[].destination' "$wallpaper_ledger" | sort))
  [[ -z $missing_wallpapers ]] || fail "wallpaper lacks provenance: $missing_wallpapers"

  while IFS= read -r -d '' file; do
    case ${file##*.} in
      png|jpg|jpeg|webp) ;;
      *) fail "wallpaper is not a supported image: ${file#$root/}" ;;
    esac
  done < <(find "$root/backgrounds" -type f -print0)
fi

printf '%s\n' 'provenance contract: ok'
