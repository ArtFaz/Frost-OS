#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
output=$(mktemp -d /tmp/frost-package-test.XXXXXX)
case $output in
  /tmp/frost-package-test.*) ;;
  *) exit 1 ;;
esac
trap 'rm -rf -- "$output"' EXIT

FROST_SOURCE="$root/../frost" PKGDEST="$output" "$root/tools/build-frost-package" >/dev/null
package=$(find "$output" -maxdepth 1 -type f -name 'frost-[0-9]*.pkg.tar.*' ! -name '*.sig' -print -quit)
if [[ -z $package ]]; then
  printf '%s\n' 'package build produced no package' >&2
  exit 1
fi

mapfile -t paths < <(bsdtar -tf "$package")
for expected in \
  usr/bin/frost \
  usr/lib/frost/frost-hyprland \
  usr/lib/frost/frost-osd \
  usr/lib/frost/frost-terminal \
  usr/lib/systemd/user/frost-session.target \
  usr/lib/systemd/user/frost-shell.service \
  usr/lib/systemd/user/frost-notifications.service \
  usr/lib/systemd/user/frost-polkit.service \
  usr/lib/systemd/user/frost-idle.service \
  usr/lib/systemd/user/frost-lock.service \
  usr/share/wayland-sessions/frost.desktop \
  usr/share/frost/default/hypr/hyprland.lua \
  usr/share/frost/default/hypr/hypridle.conf \
  usr/share/frost/default/hypr/hyprlock.conf \
  usr/share/frost/default/mako/config \
  usr/share/frost/default/ghostty/config \
  usr/share/frost/default/bash/bashrc \
  usr/share/frost/config/data/app-inventory.json \
  usr/share/frost/config/data/emojis.json \
  usr/share/frost/config/shell.json \
  usr/share/frost/shell/shell.qml \
  usr/share/frost/shell/Core/Config.qml \
  usr/share/frost/shell/Core/Motion.qml \
  usr/share/frost/shell/Core/ShellBackend.qml \
  usr/share/frost/shell/Core/SystemState.qml \
  usr/share/frost/shell/Core/Theme.qml \
  usr/share/frost/shell/Primitives/FocusRing.qml \
  usr/share/frost/shell/Primitives/GlassSurface.qml \
  usr/share/frost/shell/Primitives/InteractiveSurface.qml \
  usr/share/frost/shell/Primitives/ModuleCard.qml \
  usr/share/frost/shell/Primitives/PanelHeader.qml \
  usr/share/frost/shell/Primitives/SearchField.qml \
  usr/share/frost/shell/Primitives/SurfaceButton.qml \
  usr/share/frost/shell/Primitives/ToggleSwitch.qml \
  usr/share/frost/shell/Primitives/ValueSlider.qml \
  usr/share/frost/shell/Bar/Bar.qml \
  usr/share/frost/shell/Bar/Media.qml \
  usr/share/frost/shell/Bar/MenuButton.qml \
  usr/share/frost/shell/Bar/Status.qml \
  usr/share/frost/shell/Bar/Workspaces.qml \
  usr/share/frost/shell/Bar/Tray.qml \
  usr/share/frost/shell/Bar/Clock.qml \
  usr/share/frost/shell/Osd/Osd.qml \
  usr/share/frost/shell/Osd/OsdModel.js \
  usr/share/frost/shell/Surfaces/AppInstallerPanel.qml \
  usr/share/frost/shell/Surfaces/AudioPanel.qml \
  usr/share/frost/shell/Surfaces/BluetoothPanel.qml \
  usr/share/frost/shell/Surfaces/ClipboardPanel.qml \
  usr/share/frost/shell/Surfaces/ControlCenter.qml \
  usr/share/frost/shell/Surfaces/DisplayPowerPanel.qml \
  usr/share/frost/shell/Surfaces/EmojiPanel.qml \
  usr/share/frost/shell/Surfaces/ImagePickerPanel.qml \
  usr/share/frost/shell/Surfaces/InstallerModel.js \
  usr/share/frost/shell/Surfaces/Launcher.qml \
  usr/share/frost/shell/Surfaces/MediaCard.qml \
  usr/share/frost/shell/Surfaces/NetworkPanel.qml \
  usr/share/frost/shell/Surfaces/NotificationModel.js \
  usr/share/frost/shell/Surfaces/NotificationPanel.qml \
  usr/share/frost/shell/Surfaces/OptionalPanel.qml \
  usr/share/frost/shell/Surfaces/SurfaceHost.qml \
  usr/share/doc/frost/phase4-surface-inventory.md \
  usr/share/doc/frost/provenance/data.json \
  usr/share/doc/frost/provenance/ports.json \
  usr/share/frost/themes/frost/theme.toml; do
  if ! printf '%s\n' "${paths[@]}" | grep -qx "$expected"; then
    printf 'package is missing %s\n' "$expected" >&2
    exit 1
  fi
done

package_info=$(bsdtar -xOf "$package" .PKGINFO)
for dependency in \
  bash \
  bluez \
  brightnessctl \
  cliphist \
  ghostty \
  hypridle \
  hyprland \
  hyprlock \
  hyprpolkitagent \
  mako \
  networkmanager \
  power-profiles-daemon \
  quickshell \
  systemd \
  uwsm \
  upower \
  wireplumber \
  wl-clipboard; do
  if ! grep -Eq "^depend = ${dependency}([<=>].*)?$" <<<"$package_info"; then
    printf 'package is missing fixed session dependency %s\n' "$dependency" >&2
    exit 1
  fi
done

if printf '%s\n' "${paths[@]}" | grep -Eq '^usr/lib/systemd/user/(default|graphical-session)\.target\.wants/'; then
  printf '%s\n' 'package globally enables a Frost user unit' >&2
  exit 1
fi

if printf '%s\n' "${paths[@]}" | grep -Eiq '(omarchy|omacom)'; then
  printf '%s\n' 'package contains a donor path' >&2
  exit 1
fi

printf '%s\n' 'package build: ok'
