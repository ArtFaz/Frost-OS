#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
shell=$root/shell
config=$root/config/shell.json

fail() { printf 'island contract: %s\n' "$1" >&2; exit 1; }

jq -e '
  .schemaVersion == 3 and
  (. | keys | sort) == (["island", "schemaVersion"] | sort) and
  (.island | keys | sort) == (["enabled", "handleStyle", "idleHeight", "idleWidth"] | sort) and
  (.island.handleStyle == "bump" or .island.handleStyle == "strip") and
  (.island.idleWidth >= 300 and .island.idleWidth <= 520) and
  (.island.idleHeight >= 112 and .island.idleHeight <= 180)
' "$config" >/dev/null || fail 'schema v3 island configuration is invalid'

for mode in wifi bluetooth battery audio notifications media volume; do
  rg -Fq "\"$mode\"" "$shell/Island/DynamicGlacier.qml" || fail "island mode is missing: $mode"
done
# Both sides must carry the action: the QML allowlist and the Rust validator.
# Matching either file was enough before, which let one side drift silently.
for action in wifi-connect wifi-disconnect wifi-forget wifi-radio bluetooth-radio \
  power-profile battery-threshold notification-dnd notification-dismiss stay-awake-toggle; do
  rg -Fq "\"$action\"" "$shell/Core/ShellBackend.qml" || fail "typed island action missing from the QML allowlist: $action"
  rg -Fq "\"$action\"" "$root/cli/src/main.rs" || fail "typed island action missing from the Rust validator: $action"
done
for query in brightness indicators notifications power privacy wifi; do
  rg -Fq "\"$query\"" "$shell/Core/ShellBackend.qml" || fail "typed island query missing from the QML allowlist: $query"
done
rg -Fq 'name = "frost-island-blur"' "$root/default/hypr/hyprland.lua" || fail 'Hyprland blur rule is missing'
rg -Fq 'namespace = "^frost-island$"' "$root/default/hypr/hyprland.lua" || fail 'blur rule targets the wrong namespace'
# Anchored on a non-letter so the Mako *viewer* (toggleNotificationsPanel) is not
# mistaken for the removed notification-center surface, which owned the server.
if rg -n 'toggle(ControlCenter|Notifications|Clipboard|Emoji|Images|AppInstaller|Launcher)[^A-Za-z]' \
  "$root/default/hypr/hyprland.lua" "$shell"; then
  fail 'removed Phase 4 surface routing remains active'
fi
# Mako stays the only notification server: the island may read and act through
# makoctl, but must never register or implement one.
if rg -n 'NotificationServer|org\.freedesktop\.Notifications' "$shell"; then
  fail 'the island must not act as a notification server'
fi
# The in-island launcher and the in-island settings page were removed on purpose:
# app launching lives outside the shell and the island carries no configuration UI.
# Matched as routing, not as any occurrence of the words, so an icon glyph named
# "settings" in the shared map does not trip it.
if rg -n 'toggle (apps|settings)|mode === "(apps|settings)"|mode = "(apps|settings)"|toggle(Apps|Settings)Panel' \
  "$root/default/hypr/hyprland.lua" "$shell"; then
  fail 'removed island apps/settings routing remains active'
fi
rg -Fq 'target: "frost"' "$shell/Island/DynamicGlacier.qml" || fail 'Frost IPC target is missing'
rg -Fq 'function showOsd(payload: string)' "$shell/Island/DynamicGlacier.qml" || fail 'hardware OSD bridge is missing'
rg -Fq 'omarchy toggle bar off' "$root/tools/preview-shell" || fail 'preview does not hide the existing bar'
rg -Fq 'rule:destroy()' "$root/tools/preview-shell" || fail 'preview does not remove its Hyprland rule'
rg -Fq '_G.frost_island_preview_rule = nil' "$root/tools/preview-shell" || fail 'preview does not release its Hyprland rule handle'

printf '%s\n' 'island contract: ok'
