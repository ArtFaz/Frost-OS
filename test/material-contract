#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
theme=$root/shell/Core/Theme.qml
style=$root/shell/Core/Style.qml
motion=$root/shell/Core/Motion.qml
glass=$root/shell/Island/FrostGlassSurface.qml
surface=$root/shell/Island/IslandSurface.qml
hyprland=$root/default/hypr/hyprland.lua

fail() {
  printf 'material contract: %s\n' "$1" >&2
  exit 1
}

for token in \
  'readonly property int radius: 14' \
  'readonly property int rowRadius: 8' \
  'readonly property int controlRadius: 6' \
  'readonly property int focusWidth: 1'; do
  rg -Fq "$token" "$style" || fail "missing fixed visual token: $token"
done

rg -Fq 'readonly property color controlHover: alpha(foreground, 0.08)' "$theme" ||
  fail 'hover must use a neutral foreground fill'
rg -Fq 'readonly property color selected: alpha(accent, 0.14)' "$theme" ||
  fail 'selection must use the semantic accent'
rg -Fq 'readonly property color secondaryText: alpha(foreground, 0.62)' "$theme" ||
  fail 'secondary text must be derived from the foreground, not from the muted role'
if rg -n 'Theme\.muted' "$root/shell"; then
  fail 'the muted palette role is not readable enough to paint text or marks'
fi

rg -Fq 'readonly property real glassAmount: 1' "$glass" ||
  fail 'Frost glass is not the single permanent material'
rg -Fq 'fallbackColor: Theme.barBackground' "$surface" ||
  fail 'island surface does not consume the Frost bar material'
rg -Fq 'FrostGlassSurface {' "$surface" ||
  fail 'island does not render the Frost glass surface'
if rg -n 'liquidGlass|LiquidGlass|Material Symbols' "$root/shell"; then
  fail 'an optional Liquid Glass or Material Symbols path remains'
fi

for duration in 120 160 180; do
  rg -q "reduced \? 0 : $duration" "$motion" ||
    fail "missing bounded motion duration: $duration"
done

rg -q 'size = 5,' "$hyprland" || fail 'compositor blur size is not the approved value'
[[ $(rg -c 'name = "frost-island-blur"' "$hyprland") == 1 ]] ||
  fail 'the island must own exactly one compositor blur rule'
# One rule per Frost layer namespace, all on the same threshold: the island and
# the full-screen surfaces must not drift apart.
[[ $(rg -c 'name = "frost-surfaces-blur"' "$hyprland") == 1 ]] ||
  fail 'the surface blur rule is missing or duplicated'
[[ $(rg -c 'ignore_alpha = 0\.12,' "$hyprland") == 3 ]] ||
  fail 'the island blur rule must use the approved alpha threshold'

for role in panel menu tooltip; do
  rg -Fq "\"$role\":" "$theme" || fail "missing fixed material alpha for $role"
done

for theme_data in "$root"/themes/*/theme.toml; do
  if rg -n '(alpha|opacity|radius|spacing|blur|font|motion|geometry|size)' "$theme_data"; then
    fail "theme controls fixed material or geometry: ${theme_data#$root/}"
  fi
  if rg -q '^#[0-9A-Fa-f]{6}' "$theme_data"; then
    fail "theme contains an unassigned color: ${theme_data#$root/}"
  fi
done

printf '%s\n' 'material contract: ok'
