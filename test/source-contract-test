#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
fixture=$(mktemp -d /tmp/frost-source-contract.XXXXXX)
case $fixture in
  /tmp/frost-source-contract.*) ;;
  *) exit 1 ;;
esac
trap 'rm -rf -- "$fixture"' EXIT

mkdir -p "$fixture/bin" "$fixture/cli" "$fixture/shell" "$fixture/themes/frost"
printf '%s\n' 'safe source' >"$fixture/cli/main.rs"
printf '%s\n' 'schemaVersion = 1' >"$fixture/themes/frost/theme.toml"
FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null

printf '%s\n' 'omarchy' >"$fixture/cli/main.rs"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected donor identity fixture to fail' >&2
  exit 1
fi
printf '%s\n' 'safe source' >"$fixture/cli/main.rs"

printf '%s\n' 'readonly frost_transition_environment=OMARCHY_PATH' >"$fixture/bin/frost-hyprland"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected incomplete transition quarantine fixture to fail' >&2
  exit 1
fi
printf '%s\n' \
  'readonly frost_transition_environment=OMARCHY_PATH' \
  '/usr/bin/systemctl --user unset-environment "$frost_transition_environment"' \
  'unset "$frost_transition_environment"' >"$fixture/bin/frost-hyprland"
FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null
printf '%s\n' 'printf "%s\n" "$frost_transition_environment"' >>"$fixture/bin/frost-hyprland"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected transition variable escape fixture to fail' >&2
  exit 1
fi
rm "$fixture/bin/frost-hyprland"

printf '%s\n' 'Process {' >"$fixture/shell/Bad.qml"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected generic QML process fixture to fail' >&2
  exit 1
fi
rm "$fixture/shell/Bad.qml"

mkdir -p "$fixture/shell/Core"
printf '%s\n' 'Process {' >"$fixture/shell/Core/ShellBackend.qml"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected incomplete typed backend fixture to fail' >&2
  exit 1
fi
rm "$fixture/shell/Core/ShellBackend.qml"

printf '%s\n' '{}' >"$fixture/shell/manifest.json"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected runtime plugin manifest fixture to fail' >&2
  exit 1
fi
rm "$fixture/shell/manifest.json"

printf '%s\n' 'FolderListModel {}' >"$fixture/shell/Bad.qml"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected dynamic QML discovery fixture to fail' >&2
  exit 1
fi
rm "$fixture/shell/Bad.qml"

printf '%s\n' 'import "../../outside"' >"$fixture/shell/Bad.qml"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected external QML import fixture to fail' >&2
  exit 1
fi
rm "$fixture/shell/Bad.qml"

ln -s /tmp "$fixture/shell/outside"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected shell symlink fixture to fail' >&2
  exit 1
fi
rm "$fixture/shell/outside"

printf '%s\n' '#!/bin/bash' >"$fixture/themes/frost/install.sh"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected executable theme fixture to fail' >&2
  exit 1
fi
rm "$fixture/themes/frost/install.sh"

ln -s /tmp "$fixture/themes/frost/outside"
if FROST_SOURCE_ROOT="$fixture" "$root/test/source-contract" >/dev/null 2>&1; then
  printf '%s\n' 'expected theme symlink fixture to fail' >&2
  exit 1
fi

printf '%s\n' 'source contract fixtures: ok'
