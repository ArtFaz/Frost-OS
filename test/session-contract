#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
units=$root/default/systemd/user

fail() {
  printf 'session contract: %s\n' "$1" >&2
  exit 1
}

required_files=(
  bin/frost-hyprland
  bin/frost-osd
  bin/frost-terminal
  bin/frost-capture
  default/wayland-sessions/frost.desktop
  default/hypr/hyprland.lua
  default/hypr/hypridle.conf
  default/hypr/hyprlock.conf
  default/mako/config
  default/ghostty/config
  default/bash/bashrc
  default/starship.toml
  default/systemd/user/frost-session.target
  default/systemd/user/frost-theme.service
  default/systemd/user/frost-shell.service
  default/systemd/user/frost-stay-awake.service
  default/systemd/user/frost-notifications.service
  default/systemd/user/frost-polkit.service
  default/systemd/user/frost-idle.service
  default/systemd/user/frost-lock.service
  default/systemd/user/frost-clipboard-text.service
  default/systemd/user/frost-clipboard-image.service
)
for relative_path in "${required_files[@]}"; do
  [[ -f $root/$relative_path && ! -L $root/$relative_path ]] ||
    fail "missing regular file: $relative_path"
done

for executable in "$root/bin/frost-hyprland" "$root/bin/frost-osd" "$root/bin/frost-terminal" "$root/bin/frost-capture"; do
  [[ -x $executable ]] || fail "wrapper is not executable: ${executable#$root/}"
done

while IFS= read -r unit; do
  [[ ${unit##*/} == frost-* ]] || fail "non-Frost unit name: ${unit##*/}"
done < <(find "$units" -maxdepth 1 -type f -print)

target=$units/frost-session.target
for wanted in \
  frost-theme.service \
  frost-shell.service \
  frost-notifications.service \
  frost-polkit.service \
  frost-idle.service \
  frost-clipboard-text.service \
  frost-clipboard-image.service; do
  rg -q "^Wants=.*\\b${wanted//./\\.}\\b" "$target" || fail "target does not want $wanted"
done
rg -q '^BindsTo=graphical-session\.target$' "$target" || fail 'target is not bound to graphical-session.target'

if rg -n '^\[Install\]|WantedBy=' "$units"; then
  fail 'session units must not be globally enabled'
fi
if rg -n '^BusName=org\.freedesktop\.Notifications$' "$units"; then
  fail 'Frost units may not duplicate the upstream Mako systemd bus reservation'
fi
mapfile -t donor_matches < <(
  rg --with-filename --no-line-number -i '(omarchy|omacom|pkgs\.omarchy)' \
    "$root/bin" "$root/default" || true
)
allowed_transition_match="$root/bin/frost-hyprland:readonly frost_transition_environment=OMARCHY_PATH"
for match in "${donor_matches[@]}"; do
  [[ $match == "$allowed_transition_match" ]] || {
    printf '%s\n' "$match" >&2
    fail 'donor guard, identity, or endpoint found in Frost session assets'
  }
done
[[ ${#donor_matches[@]} == 1 ]] || fail 'Frost session boundary must declare exactly one foreign transition variable'
rg -q '^/usr/bin/systemctl --user unset-environment "\$frost_transition_environment"$' \
  "$root/bin/frost-hyprland" || fail 'Frost wrapper does not quarantine the user-manager transition environment'
rg -q '^unset "\$frost_transition_environment"$' "$root/bin/frost-hyprland" ||
  fail 'Frost wrapper does not quarantine the process transition environment'
[[ $(rg -c 'frost_transition_environment' "$root/bin/frost-hyprland") == 3 ]] ||
  fail 'foreign transition variable escaped its fixed quarantine operations'
hyprland_config=$root/default/hypr/hyprland.lua
if rg -n '\b(require|dofile|loadfile)\s*\(|os\.execute\s*\(|io\.popen\s*\(' "$hyprland_config"; then
  fail 'Hyprland Lua may not load or execute an external runtime tree'
fi
# Every keybind command is a fixed executable with data-only arguments. No
# shell interpretation may reach the compositor's exec dispatcher.
if rg -n 'exec_cmd\("[^"]*(\$\(|`|; |&&|\|\||bash -c|sh -c| \| )' "$hyprland_config"; then
  fail 'Hyprland keybind command contains shell interpretation'
fi

rg -q '^\s*hl\.exec_cmd\("systemctl --user start --no-block frost-session\.target"\)$' \
  "$hyprland_config" || fail 'Hyprland does not start only the Frost target'
if rg -n 'hyprctl dispatch dpms' "$root/default/hypr/hypridle.conf"; then
  fail 'legacy DPMS dispatcher found in Hypridle config'
fi
rg -q "hl\\.dsp\\.dpms.*action = \\\"off\\\"" "$root/default/hypr/hypridle.conf" ||
  fail 'current Hyprland DPMS-off dispatcher is missing'
rg -q '^Exec=uwsm start -e -D Frost:Hyprland /usr/lib/frost/frost-hyprland$' \
  "$root/default/wayland-sessions/frost.desktop" || fail 'desktop entry does not use the Frost UWSM wrapper'
rg -q '^exec /usr/bin/start-hyprland -- --config "\$frost_hyprland_config" "\$@"$' \
  "$root/bin/frost-hyprland" || fail 'Frost wrapper does not use start-hyprland'
rg -q '^ExecStart=/usr/bin/quickshell --path /usr/share/frost/shell/shell\.qml$' \
  "$units/frost-shell.service" || fail 'Frost shell service does not use the package-owned tree'
rg -q '^Restart=on-failure$' "$units/frost-shell.service" ||
  fail 'Frost shell service is not restartable'
rg -q '^ExecStart=/usr/bin/frost theme sync$' "$units/frost-theme.service" ||
  fail 'Frost theme materialization is not typed'
rg -q '^ExecStart=/usr/bin/frost session-notifications$' "$units/frost-notifications.service" ||
  fail 'Mako does not consume the effective Frost theme'
rg -q '^ExecStart=/usr/bin/frost session-lock$' "$units/frost-lock.service" ||
  fail 'Hyprlock does not consume the effective Frost theme'
rg -q '^ExecStart=/usr/bin/systemd-inhibit --what=idle:sleep --who=Frost --why=User-requested --mode=block /usr/bin/sleep infinity$' \
  "$units/frost-stay-awake.service" || fail 'stay-awake does not use the fixed systemd inhibitor'
if rg -q 'frost-stay-awake\.service' "$target"; then
  fail 'stay-awake must be explicitly requested, never started by the session target'
fi

lock_config=$root/default/hypr/hyprlock.conf
rg -q '^\s*module = hyprlock$' "$lock_config" || fail 'Hyprlock PAM module is not explicit'
rg -q '^\s*ignore_empty_input = false$' "$lock_config" || fail 'empty lock input is not explicitly rejected'
if rg -n -i '(nullok|on-click|onclick|cmd\[)' "$lock_config"; then
  fail 'unsafe lock authentication/action setting found'
fi
if rg -n -i '^(on-notify|on-button|on-touch)=' "$root/default/mako/config"; then
  fail 'Mako config may not execute notification hooks'
fi

bash -n "$root/bin/frost-hyprland" "$root/bin/frost-osd" "$root/bin/frost-terminal" "$root/bin/frost-capture" "$root/default/bash/bashrc"
desktop-file-validate "$root/default/wayland-sessions/frost.desktop"

if command -v Hyprland >/dev/null; then
  Hyprland --verify-config --config "$hyprland_config" >/dev/null
fi

if command -v ghostty >/dev/null; then
  ghostty_config_home=$(mktemp -d /tmp/frost-ghostty-config.XXXXXX)
  case $ghostty_config_home in
    /tmp/frost-ghostty-config.*) ;;
    *) fail 'unsafe Ghostty test directory' ;;
  esac
  trap 'rm -rf -- "$ghostty_config_home"' EXIT
  mkdir -p "$ghostty_config_home/ghostty"
  cp "$root/default/ghostty/config" "$ghostty_config_home/ghostty/config"
  XDG_CONFIG_HOME=$ghostty_config_home ghostty +validate-config
fi

printf '%s\n' 'session contract: ok'
