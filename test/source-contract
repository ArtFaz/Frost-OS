#!/bin/bash

set -euo pipefail

root=${FROST_SOURCE_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
active_roots=()
for path in bin cli config default install migrations shell themes; do
  [[ -e $root/$path ]] && active_roots+=("$root/$path")
done

fail() {
  printf 'source contract: %s\n' "$1" >&2
  exit 1
}

if ((${#active_roots[@]} > 0)); then
  mapfile -t donor_matches < <(
    rg --with-filename --no-line-number -i \
      '(omarchy|omacom|pkgs\.omarchy|github\.com/basecamp)' \
      "${active_roots[@]}" || true
  )
  allowed_transition_match="$root/bin/frost-hyprland:readonly frost_transition_environment=OMARCHY_PATH"
  for match in "${donor_matches[@]}"; do
    [[ $match == "$allowed_transition_match" ]] || {
      printf '%s\n' "$match" >&2
      fail 'donor identity or endpoint found in active source'
    }
  done

  if ((${#donor_matches[@]} > 0)); then
    wrapper=$root/bin/frost-hyprland
    rg -q '^/usr/bin/systemctl --user unset-environment "\$frost_transition_environment"$' "$wrapper" ||
      fail 'foreign transition environment is not removed from the user manager'
    rg -q '^unset "\$frost_transition_environment"$' "$wrapper" ||
      fail 'foreign transition environment is not removed from the compositor process'
    [[ $(rg -c 'frost_transition_environment' "$wrapper") == 3 ]] ||
      fail 'foreign transition environment may only be declared and unset'
  fi
fi

qml_roots=()
for path in shell default; do
  [[ -d $root/$path ]] && qml_roots+=("$root/$path")
done

if ((${#qml_roots[@]} > 0)); then
  if rg -n --glob '*.qml' --glob '*.js' '(PluginRegistry|plugin-index|rescanPlugins|setPluginEnabled|listPlugins|NotificationServer|PamContext|PolkitAgent)' "${qml_roots[@]}"; then
    fail 'forbidden dynamic or security-sensitive QML primitive found'
  fi
  if rg -n --glob '*.qml' --glob '*.js' '(Quickshell\.execDetached|\bProcess\s*\{|bash[[:space:]]+-c|sh[[:space:]]+-c)' "${qml_roots[@]}"; then
    fail 'generic process execution found in QML/JavaScript'
  fi
fi

shell_root=$root/shell
if [[ -d $shell_root ]]; then
  if find "$shell_root" -type l -print -quit | grep -q .; then
    fail 'shell symlink found'
  fi
  if find "$shell_root" -type f -name manifest.json -print -quit | grep -q .; then
    fail 'runtime plugin manifest found in static shell'
  fi
  if rg -n --glob '*.qml' --glob '*.js' \
    '(FolderListModel|Qt\.createComponent|Qt\.createQmlObject|Component\.createObject|QQmlComponent)' \
    "$shell_root"; then
    fail 'runtime QML discovery or construction found in static shell'
  fi

  while IFS= read -r -d '' qml_file; do
    while IFS= read -r import_line; do
      import_path=${import_line#*\"}
      import_path=${import_path%%\"*}
      resolved_import=$(realpath -m -- "$(dirname -- "$qml_file")/$import_path")
      case $resolved_import in
        "$shell_root"|"$shell_root"/*) ;;
        *) fail "quoted QML import escapes static shell: ${qml_file#$root/}" ;;
      esac
    done < <(rg --no-filename -o '^\s*import\s+"[^"]+"' "$qml_file" || true)
  done < <(find "$shell_root" -type f -name '*.qml' -print0)
fi

if [[ -d $root/themes ]]; then
  if find "$root/themes" -type l -print -quit | grep -q .; then
    fail 'theme symlink found'
  fi
  if find "$root/themes" -type f -perm /111 -print -quit | grep -q .; then
    fail 'executable theme file found'
  fi
  while IFS= read -r -d '' file; do
    case ${file##*.} in
      toml|json|jsonc|conf|css|png|jpg|jpeg|webp|svg) ;;
      *) fail "theme file type is not data-only: ${file#$root/}" ;;
    esac
  done < <(find "$root/themes" -type f -print0)
fi

printf '%s\n' 'source contract: ok'
