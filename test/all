#!/bin/bash

set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

"$root/test/source-contract"
"$root/test/source-contract-test"
"$root/test/provenance-contract"
"$root/test/session-contract"
"$root/test/material-contract"
"$root/test/phase4-contract"
"$root/test/shell-contract"
"$root/test/qml-contract"
"$root/test/packages-contract"
cargo fmt --manifest-path "$root/cli/Cargo.toml" -- --check
cargo test --manifest-path "$root/cli/Cargo.toml"

# The packaging half: PKGBUILDs, the installer and the local repository. It is
# conditional because the frost package runs this same script inside its source
# tarball, where .gitattributes has deliberately left packaging/ out.
if [[ -x $root/packaging/test/all ]]; then
  "$root/packaging/test/all"
fi
